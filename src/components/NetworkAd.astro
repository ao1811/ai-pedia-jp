---
/**
 * 広告ネットワーク用汎用コンポーネント（AdSense以外のクリック・PV連動広告用）。
 *
 * 対応プロバイダ：
 * - ninja  : 忍者AdMax（src/data/adNetworks.ts で slot→タグをマッピング）
 * - msads  : Microsoft Advertising（環境変数 PUBLIC_MSADS_<SLOT> から取得）
 * - nend   : nend（環境変数 PUBLIC_NEND_<SLOT> から取得）
 *
 * 【UX・規約の方針（2026-04-23 改訂）】
 * - 「広告」ラベルを明瞭に表示（誤認防止・ユーザーの「広告であると認識する権利」を尊重）
 * - × 閉じるボタンは 28×28px のタップターゲット、右上標準位置、ホバーでフィードバック
 * - 広告ブロックは本文と視覚的に明確に分離（周囲に 24px 以上のマージン推奨）
 * - 誤クリックを過度に誘発する配色・配置は避ける（不正クリック疑義のリスクを抑制）
 * - AdSense では closable=false を明示的に指定すること（AdSense 規約で改変不可）
 */
import { getNinjaTag } from '@/data/adNetworks';

type Props = {
  slot: string;
  provider?: 'ninja' | 'msads' | 'nend';
  className?: string;
  /** × で閉じる機能を有効化（デフォルトtrue、AdSenseでは使わないこと） */
  closable?: boolean;
};

const { slot, provider = 'ninja', className = '', closable = true } = Astro.props;

let tag: string | undefined;

if (provider === 'ninja') {
  tag = getNinjaTag(slot);
} else {
  const envKey = `PUBLIC_${provider.toUpperCase()}_${slot.toUpperCase().replace(/-/g, '_')}`;
  tag = (import.meta.env as Record<string, string | undefined>)[envKey];
}

const isActive = Boolean(tag && tag.trim().length > 0);
---

{isActive && tag && (
  <div
    class={`network-ad relative rounded-lg border border-white/5 bg-white/[0.02] px-4 py-3 my-6 ${className}`}
    data-network={provider}
    data-slot={slot}
    data-closable={closable ? 'true' : 'false'}
    aria-label="スポンサー広告"
  >
    {/* ヘッダー：広告ラベル＋閉じるボタン */}
    <div class="mb-2 flex items-center justify-between gap-2">
      <span
        class="inline-flex items-center gap-1.5 rounded-md bg-white/5 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.2em] text-[#a8adc2]"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber-400"></span>
        PR / 広告
      </span>
      {closable && (
        <button
          type="button"
          class="close-btn inline-flex h-7 w-7 items-center justify-center rounded-lg border border-white/10 bg-white/[0.04] text-sm leading-none text-[#a8adc2] hover:bg-white/10 hover:text-white transition"
          aria-label="この広告を閉じる"
          title="閉じる"
          data-ad-close
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M1 1L13 13M13 1L1 13" />
          </svg>
        </button>
      )}
    </div>

    {/* 広告本体 */}
    <div class="flex justify-center ad-body">
      <Fragment set:html={tag} />
    </div>
  </div>
)}

<style>
  .network-ad {
    /* 本文と広告を視覚的に分離：枠＋薄背景で誤認を防止 */
    transition: opacity 0.2s ease;
  }
  .network-ad .ad-body {
    /* 広告枠内の子要素が枠を突き抜けないよう制御 */
    max-width: 100%;
    overflow: hidden;
  }
  /* 小さい画面では広告周りの余白を確保 */
  @media (max-width: 640px) {
    .network-ad {
      margin-top: 1.5rem;
      margin-bottom: 1.5rem;
    }
  }
</style>

<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    var KEY_PREFIX = 'aipedia:ad-closed:';

    // 初期ロード時、既に閉じられた広告スロットを非表示にする
    try {
      document.querySelectorAll('.network-ad[data-slot]').forEach(function (el) {
        var slot = el.getAttribute('data-slot');
        if (!slot) return;
        if (sessionStorage.getItem(KEY_PREFIX + slot) === '1') {
          el.style.display = 'none';
        }
      });
    } catch (e) { /* sessionStorage が使えない環境は無視 */ }

    // × ボタンのクリックで非表示＋sessionStorage に記憶
    document.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest && e.target.closest('[data-ad-close]');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      var wrap = btn.closest('.network-ad');
      if (!wrap) return;
      var slot = wrap.getAttribute('data-slot');
      try {
        if (slot) sessionStorage.setItem(KEY_PREFIX + slot, '1');
      } catch (e) { /* ignore */ }
      // アニメーションで閉じる
      wrap.style.transition = 'opacity 180ms ease, transform 180ms ease, max-height 220ms ease 180ms, margin 220ms ease 180ms, padding 220ms ease 180ms';
      wrap.style.overflow = 'hidden';
      wrap.style.maxHeight = wrap.offsetHeight + 'px';
      requestAnimationFrame(function () {
        wrap.style.opacity = '0';
        wrap.style.transform = 'scale(0.98)';
        setTimeout(function () {
          wrap.style.maxHeight = '0';
          wrap.style.margin = '0';
          wrap.style.padding = '0';
        }, 180);
        setTimeout(function () {
          wrap.style.display = 'none';
        }, 420);
      });
    });
  })();
</script>
