---
/**
 * トップページ用「最新記事 × 人気記事」2カラム導線セクション。
 *
 * SNS流入者（記事を紹介する投稿を見てサイトに来た人）向け設計：
 *   - 左: 新着記事（公開日降順、6本）
 *   - 右: 人気記事（ヒューリスティックスコア、TOP5）
 *   - モバイルではタブ切替で省スペース
 *   - 各カード1タップで記事へ直行
 */
import { getCollection } from 'astro:content';

const CATEGORY_JA: Record<string, string> = {
  comparison: '比較',
  howto: 'How-to',
  guide: 'ガイド',
  review: 'レビュー',
  trend: 'トレンド',
};

const all = await getCollection('guides');

// --- 新着記事（公開日降順） ---
const latest = [...all]
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 6);

// --- 人気記事（スコアリング） ---
const now = Date.now();
const D30 = 30 * 24 * 60 * 60 * 1000;
const D90 = 90 * 24 * 60 * 60 * 1000;

const popular = [...all]
  .map((g) => {
    let score = 0;
    if (g.data.featured) score += 30;
    const published = g.data.publishedAt.getTime();
    const updated = (g.data.updatedAt ?? g.data.publishedAt).getTime();
    if (now - updated <= D30) score += 20;
    if (now - published <= D90) score += 10;
    if (g.data.category === 'comparison') score += 8;
    score += (g.data.relatedTools?.length ?? 0) * 2;
    return { g, score };
  })
  .sort((a, b) => b.score - a.score)
  .slice(0, 5)
  .map((x) => x.g);

const fmt = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 mt-10">
  {/* モバイル用タブ切替（PCでは非表示） */}
  <div class="mb-4 flex gap-2 md:hidden" role="tablist" aria-label="記事セクション切替">
    <button
      type="button"
      id="tab-latest"
      class="tab-btn flex-1 rounded-lg border border-violet-400/40 bg-violet-400/15 px-4 py-2.5 text-sm font-bold text-violet-100"
      role="tab"
      aria-selected="true"
      aria-controls="panel-latest"
      data-target="latest"
    >
      🆕 新着記事
    </button>
    <button
      type="button"
      id="tab-popular"
      class="tab-btn flex-1 rounded-lg border border-white/10 bg-white/[0.04] px-4 py-2.5 text-sm font-bold text-[#c7cbde]"
      role="tab"
      aria-selected="false"
      aria-controls="panel-popular"
      data-target="popular"
    >
      🔥 人気記事
    </button>
  </div>

  <div class="grid gap-6 md:grid-cols-[1.5fr_1fr]">
    {/* 左：新着記事 */}
    <div
      id="panel-latest"
      role="tabpanel"
      aria-labelledby="tab-latest"
      class="rounded-2xl border border-violet-400/20 bg-gradient-to-br from-violet-500/[0.08] via-[#10121a] to-[#10121a] p-5 sm:p-6"
    >
      <div class="mb-4 flex items-baseline justify-between">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-violet-400/40 bg-violet-400/10 px-2.5 py-0.5 text-[10px] uppercase tracking-widest text-violet-200">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-violet-400 shadow-[0_0_8px_#a78bfa]"></span>
            LATEST
          </span>
          <h2 class="text-base sm:text-lg font-bold tracking-tight">🆕 新着記事</h2>
        </div>
        <a href="/guides/" aria-label="最新記事をすべて見る" class="text-xs text-violet-300 hover:text-violet-200 transition whitespace-nowrap">
          すべて見る →
        </a>
      </div>
      <div class="grid gap-2 sm:grid-cols-2">
        {latest.map((g) => (
          <a
            href={`/guides/${g.id}`}
            class="group relative flex items-start gap-3 overflow-hidden rounded-xl border border-white/5 bg-white/[0.02] p-3 hover:border-violet-400/40 hover:bg-violet-400/[0.04] transition"
          >
            <div class={`absolute -right-6 -top-6 h-16 w-16 rounded-full bg-gradient-to-br ${g.data.heroGradient} opacity-20 blur-xl group-hover:opacity-40 transition-opacity`}></div>
            <span class="relative text-2xl shrink-0 leading-none">{g.data.heroEmoji}</span>
            <div class="relative min-w-0 flex-1">
              <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-[#8a90a8]">
                <span>{fmt(g.data.publishedAt)}</span>
                <span>·</span>
                <span>{CATEGORY_JA[g.data.category]}</span>
                <span>·</span>
                <span>{g.data.readTimeMin}分</span>
              </div>
              <h3 class="mt-1 text-[13px] font-bold tracking-tight text-white line-clamp-2 group-hover:text-violet-200 transition">
                {g.data.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* 右：人気記事 */}
    <div
      id="panel-popular"
      role="tabpanel"
      aria-labelledby="tab-popular"
      class="rounded-2xl border border-amber-400/20 bg-gradient-to-br from-amber-500/[0.08] via-[#10121a] to-[#10121a] p-5 sm:p-6 hidden md:block"
    >
      <div class="mb-4 flex items-baseline justify-between">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/10 px-2.5 py-0.5 text-[10px] uppercase tracking-widest text-amber-200">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber-400 shadow-[0_0_8px_#fbbf24]"></span>
            POPULAR
          </span>
          <h2 class="text-base sm:text-lg font-bold tracking-tight">🔥 人気記事</h2>
        </div>
      </div>
      <ol class="space-y-2">
        {popular.map((g, i) => (
          <li>
            <a
              href={`/guides/${g.id}`}
              class="group flex items-start gap-3 rounded-xl border border-white/5 bg-white/[0.02] p-3 hover:border-amber-400/40 hover:bg-amber-400/[0.04] transition"
            >
              <span class={`inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-xs font-extrabold ${i === 0 ? 'bg-gradient-to-br from-amber-400 to-orange-500 text-black' : i === 1 ? 'bg-gradient-to-br from-slate-300 to-slate-500 text-black' : i === 2 ? 'bg-gradient-to-br from-amber-700 to-amber-900 text-amber-100' : 'bg-white/5 text-[#a8adc2]'}`}>
                {i + 1}
              </span>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-[#8a90a8]">
                  <span class="text-sm leading-none">{g.data.heroEmoji}</span>
                  <span>{CATEGORY_JA[g.data.category]}</span>
                </div>
                <h3 class="mt-1 text-[13px] font-bold tracking-tight text-white line-clamp-2 group-hover:text-amber-200 transition">
                  {g.data.title}
                </h3>
              </div>
            </a>
          </li>
        ))}
      </ol>
      <div class="mt-4 pt-3 border-t border-white/5 text-center">
        <a
          href="/guides/"
          class="inline-flex items-center gap-1 text-xs text-amber-300 hover:text-amber-200 transition"
        >
          📚 すべての記事を見る →
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    document.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest && e.target.closest('.tab-btn');
      if (!btn) return;
      var target = btn.getAttribute('data-target');
      if (!target) return;
      var tabs = document.querySelectorAll('.tab-btn');
      tabs.forEach(function (t) {
        var isActive = t === btn;
        t.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          t.classList.remove('border-white/10', 'bg-white/[0.04]', 'text-[#c7cbde]');
          t.classList.add('border-violet-400/40', 'bg-violet-400/15', 'text-violet-100');
        } else {
          t.classList.remove('border-violet-400/40', 'bg-violet-400/15', 'text-violet-100');
          t.classList.add('border-white/10', 'bg-white/[0.04]', 'text-[#c7cbde]');
        }
      });
      // パネル切替（モバイル限定）
      var latest = document.getElementById('panel-latest');
      var popular = document.getElementById('panel-popular');
      if (!latest || !popular) return;
      if (window.innerWidth < 768) {
        if (target === 'latest') {
          latest.classList.remove('hidden');
          popular.classList.add('hidden');
        } else {
          latest.classList.add('hidden');
          popular.classList.remove('hidden');
        }
      }
    });
  })();
</script>
