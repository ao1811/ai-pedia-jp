---
/**
 * FAQ セクション（FAQPage schema 対応）。
 * frontmatter の `faq` 配列から表示＋構造化データ生成。
 * AIO・Google リッチリザルト両対応。
 */
type FaqItem = { q: string; a: string };

type Props = {
  items: FaqItem[];
};

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="mt-10 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
    <h2 class="text-lg font-bold tracking-tight">❓ よくある質問</h2>
    <div class="mt-4 space-y-3">
      {items.map((item) => (
        <details class="group rounded-xl border border-white/5 bg-white/[0.02] p-4 open:bg-white/[0.04] transition">
          <summary class="cursor-pointer text-sm font-semibold text-white list-none flex items-center justify-between">
            <span class="pr-3">Q. {item.q}</span>
            <svg class="h-4 w-4 shrink-0 text-[#8a90a8] transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <div class="mt-3 text-sm leading-relaxed text-[#c7cbde] text-balance">
            A. {item.a}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
