---
/**
 * 記事を X / Facebook / LINE / はてなブックマーク で共有できるボタン群。
 *
 * 読者の拡散が PV を増やす最大レバーの一つ。X の投稿画面・はてブ登録画面は
 * クエリパラメータで text/url を渡せば事前入力された状態で開く。
 *
 * 設計方針:
 *  - 外部スクリプト（公式ウィジェット）を読み込まない。素の HTML リンクのみ。
 *    → 読み込み時間ゼロ・プライバシー影響ゼロ・PageSpeed影響ゼロ
 *  - 新規タブで開く（rel="noopener" で security）
 *  - ラベルに aria-label を付与して A11y 対応
 */

type Props = {
  url: string;
  title: string;
  hashtags?: string[];
  /** X投稿の末尾に付ける手動で書いた追加文（例: 著者ハンドル）*/
  via?: string;
};

const { url, title, hashtags = [], via = 'ai_pedia_jp' } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

// X（旧Twitter）の投稿画面プリフィル
// 投稿文: タイトル + ハッシュタグ
const xHashtagsParam = hashtags.length > 0 ? `&hashtags=${encodeURIComponent(hashtags.join(','))}` : '';
const xViaParam = via ? `&via=${encodeURIComponent(via)}` : '';
const xUrl = `https://x.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}${xHashtagsParam}${xViaParam}`;

// Facebook の投稿画面プリフィル
const fbUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;

// LINE でシェア
const lineUrl = `https://social-plugins.line.me/lineit/share?url=${encodedUrl}&text=${encodedTitle}`;

// はてなブックマークに追加
const hatenaUrl = `https://b.hatena.ne.jp/entry/?url=${encodedUrl}`;

// メールでシェア（オフライン層向け）
const mailUrl = `mailto:?subject=${encodedTitle}&body=${encodedTitle}%20%0A${encodedUrl}`;
---

<div class="share-buttons my-8 rounded-2xl border border-white/10 bg-white/[0.03] p-5">
  <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-[#a8adc2]">
    📣 この記事が役に立ったら共有する
  </p>
  <div class="flex flex-wrap gap-2">
    <a
      href={xUrl}
      target="_blank"
      rel="noopener"
      aria-label="この記事を X（旧Twitter）で共有"
      class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-black px-4 py-2 text-sm font-bold text-white transition hover:border-white/30"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      X でポスト
    </a>

    <a
      href={fbUrl}
      target="_blank"
      rel="noopener"
      aria-label="この記事を Facebook で共有"
      class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-[#1877F2] px-4 py-2 text-sm font-bold text-white transition hover:brightness-110"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
      </svg>
      Facebook
    </a>

    <a
      href={lineUrl}
      target="_blank"
      rel="noopener"
      aria-label="この記事を LINE で友だちに共有"
      class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-[#06C755] px-4 py-2 text-sm font-bold text-white transition hover:brightness-110"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19.365 9.89c.51 0 .924.414.924.923 0 .51-.414.924-.924.924h-2.32v1.395h2.32c.51 0 .925.414.925.924 0 .51-.415.923-.925.923h-3.243c-.51 0-.924-.413-.924-.923V7.54c0-.51.414-.924.924-.924h3.243c.51 0 .925.414.925.924 0 .51-.415.923-.925.923h-2.32v1.395zm-5.617 4.167c0 .51-.413.924-.924.924-.288 0-.558-.137-.732-.366l-3.067-4.165v3.607c0 .51-.414.924-.924.924-.51 0-.925-.414-.925-.924V7.54c0-.51.415-.924.925-.924.288 0 .558.137.732.366l3.067 4.165V7.54c0-.51.414-.924.924-.924s.924.414.924.924zm-7.12 0c0 .51-.414.924-.924.924-.51 0-.925-.414-.925-.924V7.54c0-.51.415-.924.925-.924.51 0 .924.414.924.924zm-2.771.924h-3.243c-.51 0-.925-.413-.925-.923V7.54c0-.51.415-.924.925-.924.51 0 .923.414.923.924v5.28h2.32c.51 0 .924.414.924.924 0 .51-.414.923-.924.923m20.143-3.03C24 5.802 18.615.979 12 .979S0 5.802 0 11.95c0 5.505 4.272 10.117 10.043 10.993.39.084.923.258 1.058.59.122.301.08.774.039 1.077l-.17 1.024c-.054.302-.241 1.18 1.032.644 1.275-.538 6.876-4.048 9.383-6.93C23.12 17.467 24 14.804 24 11.95z"/>
      </svg>
      LINE
    </a>

    <a
      href={hatenaUrl}
      target="_blank"
      rel="noopener"
      aria-label="この記事をはてなブックマークに追加"
      class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-[#00A4DE] px-4 py-2 text-sm font-bold text-white transition hover:brightness-110"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.47 0C22.421 0 24 1.58 24 3.53v16.94c0 1.95-1.58 3.53-3.53 3.53H3.53C1.579 24 0 22.421 0 20.47V3.53C0 1.58 1.579 0 3.53 0zm-3.705 14.47a1.412 1.412 0 000 2.823 1.412 1.412 0 000-2.824zm-6.47-.235H8.47v2.94h1.824c.94 0 1.568-.09 1.922-.28.61-.31.92-.92.92-1.803 0-.885-.3-1.472-.92-1.763-.354-.198-.974-.297-1.922-.297zm-.06-4.824H8.472v2.65h1.442c.81 0 1.377-.094 1.696-.282.358-.204.537-.577.537-1.12 0-.514-.181-.87-.546-1.057-.371-.194-.907-.29-1.618-.29zm-.81-2.934c1.817 0 3.058.24 3.764.72.777.533 1.166 1.398 1.166 2.595 0 .755-.223 1.377-.667 1.87-.241.277-.596.517-1.067.72.705.158 1.233.441 1.586.85.366.415.55.953.55 1.615 0 1.258-.462 2.18-1.385 2.766-.567.363-1.27.59-2.11.682-.384.04-1.264.06-2.642.06H5.823V6.478zm10.68 0v7.235h-2.234V6.478z"/>
      </svg>
      はてブ
    </a>

    <a
      href={mailUrl}
      aria-label="この記事をメールで送る"
      class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.06] px-4 py-2 text-sm font-bold text-white transition hover:bg-white/[0.12]"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
        <polyline points="22,6 12,13 2,6"/>
      </svg>
      メール
    </a>

    <button
      type="button"
      data-copy-url={url}
      aria-label="記事のURLをクリップボードにコピー"
      class="copy-url-btn inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.06] px-4 py-2 text-sm font-bold text-white transition hover:bg-white/[0.12]"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
      <span class="copy-label">URLコピー</span>
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;
    document.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest && e.target.closest('.copy-url-btn');
      if (!btn) return;
      var url = btn.getAttribute('data-copy-url');
      if (!url || !navigator.clipboard) return;
      navigator.clipboard.writeText(url).then(function () {
        var label = btn.querySelector('.copy-label');
        if (!label) return;
        var orig = label.textContent;
        label.textContent = 'コピー完了 ✓';
        setTimeout(function () {
          label.textContent = orig;
        }, 1600);
      });
    });
  })();
</script>
