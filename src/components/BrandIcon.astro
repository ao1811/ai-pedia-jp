---
/**
 * ツールの公式ブランドアイコンを表示するコンポーネント。
 *
 * - Tool 定義の logoEmoji を直接表示（外部 favicon API への依存を排除）
 * - 丸いグラデーション背景内にアイコンを配置（ブランドカラーを活かす）
 * - PageSpeed 改善のため Google favicon API への30+リクエストを削除（2026-05-02）
 *
 * 使い方：
 *   <BrandIcon tool={tool} size="lg" />
 */
import type { Tool } from '@/types/tool';

type Props = {
  tool: Tool;
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  class?: string;
};

const { tool, size = 'md', class: extraClass = '' } = Astro.props;

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  sm: 'h-8 w-8 text-base',
  md: 'h-10 w-10 text-xl',
  lg: 'h-12 w-12 text-2xl',
  xl: 'h-14 w-14 text-3xl',
  '2xl': 'h-16 w-16 text-3xl',
};
const innerSizeClass: Record<NonNullable<Props['size']>, string> = {
  sm: 'h-5 w-5 text-sm',
  md: 'h-6 w-6 text-base',
  lg: 'h-8 w-8 text-xl',
  xl: 'h-9 w-9 text-2xl',
  '2xl': 'h-10 w-10 text-2xl',
};
---

<div
  class={`relative flex shrink-0 items-center justify-center rounded-xl bg-gradient-to-br ${tool.accentGradient} shadow-lg shadow-black/40 ring-1 ring-white/20 ${sizeClasses[size]} ${extraClass}`}
  aria-label={`${tool.name} ロゴ`}
>
  {/* Inner white circle with emoji icon */}
  <div class={`flex items-center justify-center rounded-lg bg-white/95 ${innerSizeClass[size]} p-0.5 leading-none`}>
    <span class="leading-none">{tool.logoEmoji}</span>
  </div>
</div>
