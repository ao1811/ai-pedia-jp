---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RankingCard from '@/components/RankingCard.astro';
import HeroTop3 from '@/components/HeroTop3.astro';
import AdSlot from '@/components/AdSlot.astro';
import NetworkAd from '@/components/NetworkAd.astro';
import SponsoredCTA from '@/components/SponsoredCTA.astro';
import LatestAndPopular from '@/components/LatestAndPopular.astro';
import ArticleBrowserHome from '@/components/ArticleBrowserHome.astro';
import { getRankedTools } from '@/data/tools';
import { affiliateUrls } from '@/data/affiliate';
import { CATEGORY_LABELS } from '@/types/tool';
import { getCollection } from 'astro:content';

const sponsoredSlugs = Object.keys(affiliateUrls).filter((k) => affiliateUrls[k]);

const allTools = getRankedTools();
const top3 = allTools.slice(0, 3);
const rest = allTools.slice(3);

const CATEGORY_JA: Record<string, string> = {
  comparison: '比較',
  howto: 'How-to',
  guide: 'ガイド',
  review: 'レビュー',
  trend: 'トレンド',
};

const allGuides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const featuredGuides = allGuides.filter((g) => g.data.featured).slice(0, 4);

// 「新機能」タグを持つ最新記事を抽出
const newFeatureGuides = allGuides
  .filter((g) => (g.data.tags ?? []).includes('新機能'))
  .slice(0, 6);

// 4位以降を前半・後半に分けて間に広告を挟む
const restFirst = rest.slice(0, Math.ceil(rest.length / 2));
const restLast = rest.slice(Math.ceil(rest.length / 2));

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const title = 'AIランキング 2026年4月最新【AIツール比較】ChatGPT・Claude・Gemini を5軸で徹底比較 | AIpedia';
const description = 'AIランキング 2026年4月最新版。ChatGPT・Claude・Gemini・Cursor・Midjourney など主要AIツールを「応答品質・日本語精度・コスパ・拡張性・トレンド」の独自5軸で徹底比較。初心者の選び方から業務導入まで、あなたに最適な1本を数字で示すAIツール比較ランキングメディア。';
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 sm:pt-10">
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-violet-400/30 bg-violet-400/10 px-3 py-1 text-violet-300">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-violet-400 shadow-[0_0_8px_#a78bfa]"></span>
          2026年4月 最新ランキング
        </span>
        <span class="text-[#8a90a8]">毎週更新 ・ 全{allTools.length}ツール ・ 徹底特集 {allGuides.length}本</span>
      </div>
      <h1 class="text-balance text-3xl sm:text-5xl font-extrabold tracking-tight">
        <span class="bg-gradient-to-r from-violet-400 via-fuchsia-400 to-orange-300 bg-clip-text text-transparent">AIランキング 2026年4月最新</span><br/>
        <span class="text-2xl sm:text-3xl">主要AIツールを5軸で徹底比較</span>
      </h1>
      <p class="max-w-2xl text-[15px] leading-relaxed text-[#c7cbde] text-balance">
        ChatGPT・Claude・Gemini・Cursor・Midjourney など <strong class="text-white">主要AIツール{allTools.length}本</strong> を「応答品質 / 日本語精度 / コスパ / 拡張性 / トレンド」の独自5軸で評価したAIランキング。利用シーン別に、あなたにとっての最適解を数字で示します。
      </p>
    </div>

    {/* ヒーロー直下のナビゲーションチップ（記事導線を最優先・SNS流入対応） */}
    <div class="mt-6 flex flex-wrap gap-2 text-xs">
      <a href="#latest-popular" class="inline-flex items-center gap-1.5 rounded-full border border-violet-400/40 bg-violet-400/15 px-3 py-1.5 text-violet-100 hover:bg-violet-400/25 transition font-semibold">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-violet-400 shadow-[0_0_8px_#a78bfa]"></span>
        🆕 新着記事
      </a>
      <a href="#latest-popular" class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/40 bg-amber-400/15 px-3 py-1.5 text-amber-100 hover:bg-amber-400/25 transition font-semibold">
        🔥 人気記事
      </a>
      <a href="/tags/新機能" class="inline-flex items-center gap-1.5 rounded-full border border-rose-400/40 bg-rose-400/10 px-3 py-1.5 text-rose-200 hover:bg-rose-400/20 transition">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-rose-400 shadow-[0_0_8px_#fb7185]"></span>
        新機能・最新情報
      </a>
      <a href="/guides" class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">
        📚 徹底特集一覧
      </a>
      <a href="/compare?tools=chatgpt,claude,gemini" class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">
        ⚔️ 3強 横並び比較
      </a>
      <a href="/guides/free-ai-ranking-2026" class="inline-flex items-center gap-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10 px-3 py-1.5 text-emerald-200 hover:bg-emerald-400/20 transition">
        🆓 完全無料ランキング
      </a>
    </div>
  </section>

  {/* SNS流入者向け：新着 × 人気の2カラム導線（ヒーロー直下、TOP3より上） */}
  <div id="latest-popular" class="scroll-mt-20">
    <LatestAndPopular />
  </div>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-12">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-lg font-bold tracking-tight">🏆 AIランキング TOP 3｜2026年4月最新</h2>
      <span class="text-xs text-[#8a90a8]">5軸評価の総合スコア上位</span>
    </div>
    <HeroTop3 tools={top3} />
  </section>

  {/* AdSense 審査対策：スポンサード露出は後半に配置（コンテンツファーストの構成） */}

  {/* 新機能・最新情報セクション（TOP3 直後、特集よりも先） */}
  {newFeatureGuides.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-12">
      <div class="mb-5 flex items-baseline justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-rose-400/40 bg-rose-400/10 px-2.5 py-0.5 text-[10px] uppercase tracking-widest text-rose-200">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-rose-400 shadow-[0_0_8px_#fb7185]"></span>
              NEW
            </span>
            <h2 class="text-lg sm:text-xl font-bold tracking-tight">🆕 新機能・最新情報</h2>
          </div>
          <p class="mt-1 text-xs text-[#8a90a8]">2026年に登場したAI新機能を専門記事で解説（全 {newFeatureGuides.length} 本）</p>
        </div>
        <a href="/tags/新機能" aria-label="新機能タグの記事をすべて見る" class="inline-flex items-center gap-1 text-xs text-rose-300 hover:text-rose-200 transition whitespace-nowrap">
          すべて見る →
        </a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {newFeatureGuides.map((g) => (
          <a
            href={`/guides/${g.id}`}
            class="group relative overflow-hidden rounded-2xl border border-white/10 p-5 card-hover"
          >
            <div class={`absolute inset-0 bg-gradient-to-br ${g.data.heroGradient} opacity-20`}></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#08090d] via-[#08090d]/60 to-transparent"></div>
            <div class="relative">
              <div class="flex items-center justify-between">
                <span class="text-3xl">{g.data.heroEmoji}</span>
                <span class="inline-flex items-center gap-1 rounded-full border border-rose-400/40 bg-rose-400/15 px-2 py-0.5 text-[10px] uppercase tracking-wider text-rose-200 backdrop-blur">
                  <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-rose-400"></span>
                  NEW
                </span>
              </div>
              <h3 class="mt-3 text-sm sm:text-base font-bold tracking-tight text-white text-balance line-clamp-2">{g.data.title}</h3>
              <p class="mt-2 text-[12px] text-[#c7cbde] line-clamp-2">{g.data.description}</p>
              <div class="mt-3 text-[11px] text-[#8a90a8]">{g.data.readTimeMin}分で読める</div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {/* 注目記事（大カード）+ 全記事ブラウザ（タブ＋検索） */}
  <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-12">
    <div class="mb-5 flex items-baseline justify-between">
      <div>
        <h2 class="text-lg sm:text-xl font-bold tracking-tight">📚 編集部おすすめ</h2>
        <p class="mt-1 text-xs text-[#8a90a8]">いま読まれている特集記事</p>
      </div>
      <a href="/guides" aria-label="すべての特集を見る" class="inline-flex items-center gap-1 text-xs text-amber-300 hover:text-amber-200 transition whitespace-nowrap">
        すべて見る →
      </a>
    </div>

    {/* 注目記事：大きめカードを2つ横並び */}
    {featuredGuides.length > 0 && (
      <div class="grid gap-4 md:grid-cols-2">
        {featuredGuides.slice(0, 2).map((g) => (
          <a
            href={`/guides/${g.id}`}
            class="group relative overflow-hidden rounded-2xl border border-white/10 p-6 card-hover min-h-[180px]"
          >
            <div class={`absolute inset-0 bg-gradient-to-br ${g.data.heroGradient} opacity-30`}></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#08090d] via-[#08090d]/60 to-transparent"></div>
            <div class="relative flex h-full flex-col">
              <div class="flex items-center justify-between">
                <span class="text-4xl">{g.data.heroEmoji}</span>
                <span class="rounded-full border border-white/20 bg-black/40 px-2.5 py-1 text-[10px] uppercase tracking-wider text-white backdrop-blur">
                  {CATEGORY_JA[g.data.category] ?? g.data.category}
                </span>
              </div>
              <div class="mt-auto pt-6">
                <h3 class="text-lg sm:text-xl font-extrabold tracking-tight text-white text-balance line-clamp-2">{g.data.title}</h3>
                <p class="mt-2 text-sm text-[#c7cbde] line-clamp-2">{g.data.description}</p>
                <div class="mt-3 flex items-center gap-2 text-[11px] text-[#8a90a8]">
                  <span>{fmt(g.data.publishedAt)}</span>
                  <span>·</span>
                  <span>{g.data.readTimeMin}分で読める</span>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  {/* 全記事ブラウザ（タブ＋検索） — 全34本にこのセクションだけでアクセス可能 */}
  <ArticleBrowserHome />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-10 space-y-4">
    <AdSlot slot="display-home-top" />
    <NetworkAd slot="home-rankings-mid" provider="ninja" />
  </section>

  {/* 4位以降 前半 */}
  <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-12">
    <div class="mb-5 flex items-baseline justify-between">
      <h2 class="text-lg font-bold tracking-tight">AIランキング 4位以降｜全{allTools.length}ツール総合比較</h2>
      <a href="/category" class="text-xs text-[#8a90a8] hover:text-white">カテゴリで絞り込む →</a>
    </div>
    <div class="grid gap-3 md:grid-cols-2">
      {restFirst.map((tool, i) => (
        <RankingCard tool={tool} rank={i + 4} />
      ))}
    </div>
  </section>

  {/* スポンサード（ランキング中間に1箇所のみ・PR表記明示） */}
  {sponsoredSlugs.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-10">
      <div class="mb-3 flex items-center gap-2">
        <span class="inline-flex items-center rounded bg-amber-400/20 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-200">PR</span>
        <h2 class="text-sm font-semibold text-[#c7cbde]">パートナー紹介</h2>
      </div>
      <div class="grid gap-3">
        {sponsoredSlugs.map((slug) => (
          <SponsoredCTA slug={slug} variant="compact" />
        ))}
      </div>
    </section>
  )}

  {/* 4位以降 後半 */}
  {restLast.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-10">
      <div class="grid gap-3 md:grid-cols-2">
        {restLast.map((tool, i) => (
          <RankingCard tool={tool} rank={restFirst.length + i + 4} />
        ))}
      </div>
    </section>
  )}

  {/* フッター前の広告ネットワーク枠 */}
  <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-10">
    <NetworkAd slot="home-bottom" provider="ninja" />
  </section>

  {/* もっと読む導線 */}
  <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-12">
    <div class="rounded-2xl border border-amber-400/20 bg-gradient-to-br from-amber-500/5 via-orange-500/5 to-rose-500/5 p-6 sm:p-8">
      <div class="grid gap-4 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight">もっと深く知りたいなら、徹底特集へ</h2>
          <p class="mt-2 text-sm text-[#c7cbde] leading-relaxed">
            ChatGPT・Claude・Cursor など主要ツールの実践ガイド、比較記事、失敗回避術まで {allGuides.length} 本。公式情報・主要メディア・編集部の利用所感をもとに執筆しています。
          </p>
        </div>
        <a href="/guides" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 via-orange-500 to-rose-500 px-5 py-3 text-sm font-bold text-black hover:opacity-90 transition whitespace-nowrap">
          徹底特集を読む
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-12">
    <div class="mb-5">
      <h2 class="text-lg font-bold tracking-tight">カテゴリ別に探す</h2>
      <p class="mt-1 text-sm text-[#8a90a8]">用途が決まっているなら、カテゴリから最短で最適解へ</p>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {(Object.entries(CATEGORY_LABELS) as [keyof typeof CATEGORY_LABELS, (typeof CATEGORY_LABELS)[keyof typeof CATEGORY_LABELS]][]).map(([key, c]) => (
        <a
          href={`/category/${key}`}
          class="group relative overflow-hidden rounded-xl border border-white/5 bg-[#10121a]/80 p-4 card-hover"
        >
          <div class={`absolute -right-8 -top-8 h-24 w-24 rounded-full bg-gradient-to-br ${c.accent} opacity-20 blur-2xl transition-opacity group-hover:opacity-40`}></div>
          <div class="relative flex items-center gap-3">
            <span class="text-2xl">{c.emoji}</span>
            <div>
              <div class="font-semibold">{c.ja}</div>
              <div class="text-[11px] text-[#8a90a8]">詳細 →</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 mt-12 mb-4">
    <div class="rounded-2xl border border-white/5 bg-gradient-to-br from-[#10121a] to-[#161926] p-6 sm:p-10">
      <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight">評価基準は明確に。忖度なしで比較します。</h2>
          <p class="mt-3 text-sm text-[#c7cbde] leading-relaxed text-balance">
            ランキングは「応答品質・日本語精度・コスパ・拡張性・トレンド」の5軸。実際の使用ログ、公式スペック、ユーザーレビューをもとに独自スコアを算出しています。アフィリエイトの有無はランキングに影響しません。
          </p>
        </div>
        <a href="/about" class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm hover:bg-white/10 whitespace-nowrap">
          評価基準を読む
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
