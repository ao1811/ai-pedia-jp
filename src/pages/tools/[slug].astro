---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AdSlot from '@/components/AdSlot.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { tools, getToolBySlug } from '@/data/tools';
import { getAffiliateUrl, getLinkRel } from '@/data/affiliate';
import { CATEGORY_LABELS } from '@/types/tool';

export function getStaticPaths() {
  return tools.map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const tool = getToolBySlug(slug!);
if (!tool) return Astro.redirect('/404');

const cat = CATEGORY_LABELS[tool.category];
const stars = Math.round(tool.rating);

const description = `${tool.name}（${tool.vendor}）の特徴・料金・評判を徹底レビュー。${tool.tagline} 独自評価スコア ${tool.rating.toFixed(1)}/5。`;

const affUrl = getAffiliateUrl(tool.slug) ?? tool.affiliateUrl;
const ctaUrl = affUrl ?? tool.officialUrl;
const isAffiliate = Boolean(affUrl);
const linkRel = getLinkRel(isAffiliate);

const rankedTools = [...tools].sort((a, b) => b.popularityScore - a.popularityScore);
const rank = rankedTools.findIndex((t) => t.slug === tool.slug) + 1;

// JSON-LD (SEO)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name,
  applicationCategory: cat.ja,
  operatingSystem: 'Web',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: tool.rating,
    reviewCount: tool.reviewCount,
    bestRating: 5,
    worstRating: 0,
  },
  offers: tool.pricing.map((p) => ({
    '@type': 'Offer',
    name: p.name,
    price: p.amount,
    priceCurrency: p.currency,
  })),
};
---

<BaseLayout title={`${tool.name} レビュー・料金・評判`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="mx-auto max-w-5xl px-4 sm:px-6 pt-6">
    <nav class="text-xs text-[#8a90a8]">
      <a href="/" class="hover:text-white">ホーム</a>
      <span class="mx-1.5">/</span>
      <a href={`/category/${tool.category}`} class="hover:text-white">{cat.ja}</a>
      <span class="mx-1.5">/</span>
      <span class="text-[#c7cbde]">{tool.name}</span>
    </nav>

    <header class="mt-6 overflow-hidden rounded-3xl border border-white/10 relative">
      <div class={`absolute inset-0 bg-gradient-to-br ${tool.accentGradient} opacity-25`}></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#08090d] via-[#08090d]/70 to-transparent"></div>
      <div class="relative p-6 sm:p-10">
        <div class="flex items-center gap-2 text-xs">
          <span class="inline-flex items-center gap-1 rounded-full border border-white/20 bg-black/30 px-2.5 py-1 backdrop-blur text-white">
            #{rank} / 総合ランキング
          </span>
          <span class="inline-flex items-center gap-1 rounded-full border border-white/20 bg-black/30 px-2.5 py-1 backdrop-blur text-[#c7cbde]">
            {cat.emoji} {cat.ja}
          </span>
        </div>
        <div class="mt-5 flex items-start gap-4">
          <BrandIcon tool={tool} size="2xl" />
          <div class="min-w-0">
            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white text-balance">{tool.name}</h1>
            <div class="mt-1 text-sm text-[#c7cbde]">{tool.vendor} ・ {tool.launchedYear}年リリース</div>
          </div>
        </div>
        <p class="mt-4 text-lg text-white/90 text-balance">{tool.tagline}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2 text-xs">
          <span class="inline-flex items-center gap-1 rounded-lg border border-amber-400/40 bg-amber-400/15 px-3 py-1.5 text-amber-100 backdrop-blur">
            <span class="tracking-[2px]">
              {'★'.repeat(stars)}<span class="opacity-30">{'★'.repeat(5 - stars)}</span>
            </span>
            <span class="font-bold text-amber-50">{tool.rating.toFixed(1)}</span>
            <span class="text-amber-200/80">/ 5</span>
            <span class="ml-1 text-amber-200/60">({tool.reviewCount.toLocaleString()}件)</span>
          </span>
          {tool.japanSupport === 'full' && (
            <span class="rounded-lg border border-sky-400/30 bg-sky-400/15 px-3 py-1.5 text-sky-100 backdrop-blur">🇯🇵 日本語完全対応</span>
          )}
          {tool.hasFreePlan && (
            <span class="rounded-lg border border-emerald-400/30 bg-emerald-400/15 px-3 py-1.5 text-emerald-100 backdrop-blur">無料プランあり</span>
          )}
        </div>

        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a
            href={ctaUrl}
            target="_blank"
            rel={linkRel}
            class={
              isAffiliate
                ? 'inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 via-orange-500 to-rose-500 px-5 py-3 font-bold text-black hover:opacity-90 transition'
                : 'inline-flex items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 font-semibold text-black hover:bg-white/90 transition'
            }
          >
            {isAffiliate && (
              <span class="inline-flex items-center rounded bg-black/20 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider">PR</span>
            )}
            公式サイトで{tool.hasFreePlan ? '無料で試す' : '詳細を見る'}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M7 7h10v10" /></svg>
          </a>
          {isAffiliate && (
            <span class="text-[11px] text-[#8a90a8] sm:self-center">※本リンクはアフィリエイトを含みます</span>
          )}
        </div>
      </div>
    </header>

    <AdSlot slot="in-article-top" className="mt-10" />

    <section class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-5">
        <div class="text-sm font-semibold text-emerald-300">👍 メリット</div>
        <ul class="mt-3 space-y-2 text-sm text-[#c7cbde]">
          {tool.pros.map((p) => (
            <li class="flex gap-2">
              <span class="shrink-0 text-emerald-400">✓</span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-rose-400/20 bg-rose-400/5 p-5">
        <div class="text-sm font-semibold text-rose-300">👎 デメリット</div>
        <ul class="mt-3 space-y-2 text-sm text-[#c7cbde]">
          {tool.cons.map((c) => (
            <li class="flex gap-2">
              <span class="shrink-0 text-rose-400">✕</span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-base font-bold">概要</h2>
      <p class="mt-3 text-sm leading-relaxed text-[#c7cbde] text-balance">{tool.description}</p>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-base font-bold">こんな人におすすめ</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-3">
        {tool.bestFor.map((b) => (
          <li class="rounded-lg border border-white/5 bg-white/[0.02] p-3 text-sm text-[#c7cbde]">
            <span class="text-violet-400">→</span> {b}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-base font-bold">主要機能</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {tool.keyFeatures.map((f) => (
          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-[#c7cbde]">{f}</span>
        ))}
      </div>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-base font-bold">料金プラン</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-3">
        {tool.pricing.map((p) => (
          <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
            <div class="text-xs text-[#8a90a8]">{p.name}</div>
            <div class="mt-1 text-xl font-bold">
              {p.amount === 0 ? '無料' : `${p.currency === 'USD' ? '$' : '¥'}${p.amount.toLocaleString()}`}
              {p.billing === 'monthly' && <span class="text-xs font-normal text-[#8a90a8]"> /月</span>}
              {p.billing === 'yearly' && <span class="text-xs font-normal text-[#8a90a8]"> /年</span>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <div class="mt-10 rounded-2xl border border-white/10 bg-gradient-to-br from-[#10121a] to-[#161926] p-6 text-center">
      <div class="text-sm text-[#8a90a8]">まずは試してみる</div>
      <div class="mt-2 text-xl font-bold">{tool.name} を公式サイトでチェック</div>
      <a
        href={ctaUrl}
        target="_blank"
        rel={linkRel}
        class="mt-5 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-violet-500 to-fuchsia-500 px-6 py-3 font-semibold text-white hover:opacity-90 transition"
      >
        公式サイトへ
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
      </a>
    </div>
  </article>
</BaseLayout>
