---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const tagSet = new Set<string>();
  guides.forEach((g) => {
    (g.data.tags ?? []).forEach((t) => tagSet.add(t));
  });
  // タグ名はそのまま渡す（Astro がファイル名として安全にエンコード）
  // encodeURIComponent を使うと dist 側に "%E6%96%B0..." という literal な
  // フォルダ名ができ、Cloudflare Pages が URL デコード後にマッチできなくなる
  return Array.from(tagSet).map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

const { tag } = Astro.props;
const allGuides = await getCollection('guides');
const matched = allGuides
  .filter((g) => (g.data.tags ?? []).includes(tag))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const CATEGORY_JA: Record<string, string> = {
  comparison: '比較',
  howto: 'How-to',
  guide: 'ガイド',
  review: 'レビュー',
  trend: 'トレンド',
};

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const title = `「${tag}」タグの記事一覧`;
const description = `${tag} に関する徹底特集・ガイド記事 ${matched.length} 本。編集部がまとめた実用情報。`;
---

<BaseLayout title={title} description={description}>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-6 sm:pt-10">
    <Breadcrumbs
      items={[
        { label: 'ホーム', href: '/' },
        { label: '徹底特集', href: '/guides' },
        { label: `タグ: ${tag}` },
      ]}
    />

    <div class="mt-4">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs text-amber-300">
        🏷️ タグ
      </span>
      <h1 class="mt-3 text-3xl sm:text-4xl font-extrabold tracking-tight">
        {tag}
      </h1>
      <p class="mt-2 text-sm text-[#c7cbde]">関連記事 {matched.length} 本</p>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {matched.map((g) => (
        <a
          href={`/guides/${g.id}`}
          class="group relative overflow-hidden rounded-xl border border-white/5 bg-[#10121a]/80 p-5 card-hover"
        >
          <div class={`absolute -right-8 -top-8 h-24 w-24 rounded-full bg-gradient-to-br ${g.data.heroGradient} opacity-20 blur-2xl group-hover:opacity-40 transition-opacity`}></div>
          <div class="relative">
            <div class="flex items-center justify-between">
              <span class="text-2xl">{g.data.heroEmoji}</span>
              <span class="text-[10px] uppercase tracking-wider text-[#8a90a8]">{CATEGORY_JA[g.data.category]}</span>
            </div>
            <h3 class="mt-3 text-base font-bold tracking-tight text-white text-balance line-clamp-2">{g.data.title}</h3>
            <p class="mt-2 text-[13px] text-[#8a90a8] line-clamp-2">{g.data.description}</p>
            <div class="mt-3 flex items-center gap-2 text-[11px] text-[#8a90a8]">
              <span>{fmt(g.data.publishedAt)}</span>
              <span>·</span>
              <span>{g.data.readTimeMin}分</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    {matched.length === 0 && (
      <div class="mt-10 rounded-2xl border border-white/5 bg-[#10121a] p-10 text-center text-[#8a90a8]">
        このタグの記事はまだありません。
      </div>
    )}
  </section>
</BaseLayout>
