---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allGuides = (await getCollection('guides'))
  .filter((g) => !g.data.noIndex)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const featuredGuides = allGuides.filter((g) => g.data.featured).slice(0, 4);
const recentGuides = allGuides.slice(0, 6);
---

<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。AIpedia の人気記事から関連する情報をお探しください。" noIndex>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 pt-12 sm:pt-20 pb-16">
    <div class="text-center">
      <div class="text-7xl font-extrabold tracking-tight bg-gradient-to-r from-violet-400 via-fuchsia-400 to-orange-300 bg-clip-text text-transparent">404</div>
      <h1 class="mt-4 text-2xl sm:text-3xl font-bold">ページが見つかりませんでした</h1>
      <p class="mt-3 text-sm text-[#c7cbde]">
        URL のご確認をお願いします。お探しの情報は、以下の人気記事・カテゴリから見つかるかもしれません。
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-lg bg-white px-4 py-2 text-sm font-semibold text-black hover:bg-white/90">ホームへ戻る</a>
        <a href="/category/" class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm hover:bg-white/10">カテゴリ一覧</a>
        <a href="/guides/" class="rounded-lg border border-white/10 bg-white/5 px-4 py-2 text-sm hover:bg-white/10">記事一覧</a>
      </div>
    </div>

    {featuredGuides.length > 0 && (
      <div class="mt-12">
        <h2 class="text-lg font-bold mb-4">📌 編集部おすすめの記事</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {featuredGuides.map((g) => (
            <a href={`/guides/${g.id}/`} class="group rounded-xl border border-white/5 bg-[#10121a]/80 p-4 hover:border-violet-400/30 transition-colors">
              <div class="flex items-start gap-3">
                <span class="text-2xl">{g.data.heroEmoji}</span>
                <div class="flex-1">
                  <h3 class="text-sm font-bold leading-tight group-hover:text-violet-300 transition-colors">{g.data.title}</h3>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {recentGuides.length > 0 && (
      <div class="mt-10">
        <h2 class="text-lg font-bold mb-4">🆕 最近の更新</h2>
        <ul class="space-y-2 text-sm">
          {recentGuides.map((g) => (
            <li>
              <a href={`/guides/${g.id}/`} class="text-violet-300 hover:text-violet-200 hover:underline">
                {g.data.heroEmoji} {g.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>
