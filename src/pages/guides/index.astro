---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const CATEGORY_JA: Record<string, string> = {
  comparison: '比較',
  howto: 'How-to',
  guide: 'ガイド',
  review: 'レビュー',
  trend: 'トレンド',
};

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const featured = guides.filter((g) => g.data.featured);
const rest = guides.filter((g) => !g.data.featured);

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title="特集記事・ガイド一覧"
  description="AIツールの比較記事、選び方ガイド、業界トレンド解説など。編集部が実使用した上で執筆した詳細記事を一覧でどうぞ。"
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 sm:pt-10">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-amber-300">
        📚 特集・ガイド
      </span>
      <span class="text-[#8a90a8]">全 {guides.length} 記事</span>
    </div>
    <h1 class="mt-3 text-balance text-3xl sm:text-5xl font-extrabold tracking-tight">
      編集部が<span class="bg-gradient-to-r from-amber-300 via-orange-400 to-rose-400 bg-clip-text text-transparent">実使用</span>して書いた、深く・使える記事
    </h1>
    <p class="mt-3 text-sm text-[#c7cbde]">比較・選び方・節約術・業界トレンドまで、AIツールに関する実務情報を体系的に。</p>

    {featured.length > 0 && (
      <div class="mt-8">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">注目記事</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {featured.map((g) => (
            <a
              href={`/guides/${g.id}`}
              class="group relative overflow-hidden rounded-2xl border border-white/10 p-6 card-hover min-h-[180px]"
            >
              <div class={`absolute inset-0 bg-gradient-to-br ${g.data.heroGradient} opacity-30`}></div>
              <div class="absolute inset-0 bg-gradient-to-t from-[#08090d] via-[#08090d]/60 to-transparent"></div>
              <div class="relative flex h-full flex-col">
                <div class="flex items-center justify-between">
                  <span class="text-4xl">{g.data.heroEmoji}</span>
                  <span class="rounded-full border border-white/20 bg-black/30 px-2.5 py-1 text-[10px] uppercase tracking-wider text-white backdrop-blur">
                    {CATEGORY_JA[g.data.category] ?? g.data.category}
                  </span>
                </div>
                <div class="mt-auto pt-8">
                  <h3 class="text-lg sm:text-xl font-extrabold tracking-tight text-white text-balance">{g.data.title}</h3>
                  <p class="mt-2 text-sm text-[#c7cbde] line-clamp-2">{g.data.description}</p>
                  <div class="mt-3 flex items-center gap-2 text-[11px] text-[#8a90a8]">
                    <span>{fmt(g.data.publishedAt)}</span>
                    <span>·</span>
                    <span>{g.data.readTimeMin}分で読める</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="mt-12">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">すべての記事</h2>
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((g) => (
          <a
            href={`/guides/${g.id}`}
            class="group relative overflow-hidden rounded-2xl border border-white/5 bg-[#10121a]/80 p-5 card-hover"
          >
            <div class={`absolute -right-8 -top-8 h-24 w-24 rounded-full bg-gradient-to-br ${g.data.heroGradient} opacity-20 blur-2xl group-hover:opacity-40 transition-opacity`}></div>
            <div class="relative">
              <div class="flex items-center justify-between">
                <span class="text-2xl">{g.data.heroEmoji}</span>
                <span class="text-[10px] uppercase tracking-wider text-[#8a90a8]">{CATEGORY_JA[g.data.category]}</span>
              </div>
              <h3 class="mt-4 text-base font-bold tracking-tight text-white text-balance line-clamp-2">{g.data.title}</h3>
              <p class="mt-2 text-[13px] text-[#8a90a8] line-clamp-2">{g.data.description}</p>
              <div class="mt-3 flex items-center gap-2 text-[11px] text-[#8a90a8]">
                <span>{fmt(g.data.publishedAt)}</span>
                <span>·</span>
                <span>{g.data.readTimeMin}分</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
