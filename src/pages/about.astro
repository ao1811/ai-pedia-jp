---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE } from '@/data/site';

const axes = [
  { label: '応答品質', weight: 30, desc: '実ユースケース（Q&A・要約・推論）での回答精度と一貫性。複数プロンプトで手動検証。' },
  { label: '日本語精度', weight: 20, desc: '日本語の自然さ・ニュアンス理解・誤訳率を定量評価。' },
  { label: 'コスパ', weight: 20, desc: '月額単価あたりの提供価値。無料枠の実用性も加点。' },
  { label: '拡張性', weight: 15, desc: 'API・連携・カスタマイズ自由度（プラグイン・MCP・エージェント）。' },
  { label: 'トレンド', weight: 15, desc: '検索ボリューム・採用企業数・アップデート頻度の成長率。' },
];

// E-E-A-T 対応：個人運営メディアとしての明示
const editorialSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#editorial`,
  name: SITE.author.name,
  url: SITE.author.url,
  parentOrganization: { '@id': `${SITE.url}/#organization` },
  description: 'AIpedia 編集部（個人運営）。2026年4月開設。AIツール・生成AI領域の比較・解説メディア。公式情報と編集部の検証をもとに継続的に情報を更新。',
  knowsAbout: [
    'AIツール',
    '生成AI',
    'ChatGPT',
    'Claude',
    'Gemini',
    'プロンプトエンジニアリング',
    'AI議事録',
    'AIコーディング',
  ],
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: 'AIツール比較情報提供',
      serviceType: 'メディア・出版',
    },
  },
};

// Person（編集長）スキーマ
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/#editor`,
  name: 'Ao',
  alternateName: ['AIpedia 編集長 Ao', 'Ao（あお）'],
  url: `${SITE.url}/author/ao`,
  jobTitle: '編集長',
  worksFor: { '@id': `${SITE.url}/#editorial` },
  description: 'AIpedia 編集長。AIツール・生成AI 領域を中心に、ビジネスパーソン向けの実用的な比較・解説記事を執筆。中立性と分かりやすさを重視。',
  knowsAbout: ['AIツール', '生成AI', 'ChatGPT', 'Claude', 'Gemini', 'AIライティング', 'AI画像生成', 'AIコーディング', 'AI議事録'],
};
---

<BaseLayout
  title="運営方針・評価基準・編集部"
  description="AIpedia（AIツール比較ランキング）の運営方針・評価基準・編集長紹介。応答品質・日本語精度・コスパ・拡張性・トレンドの5軸で独自スコアを算出しています。個人運営の独立メディア。"
  extraJsonLd={[editorialSchema, personSchema]}
>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 pt-6 sm:pt-10">
    <Breadcrumbs items={[{ label: 'ホーム', href: '/' }, { label: '運営方針・評価基準' }]} />

    <h1 class="mt-4 text-balance text-3xl sm:text-4xl font-extrabold tracking-tight">
      運営方針・評価基準・編集部
    </h1>
    <p class="mt-4 text-[15px] leading-relaxed text-[#c7cbde]">
      AIpedia（AIツール比較ランキング）は、乱立するAIツールの中から「本当に使えるもの」を見抜く判断材料を、できるだけフェアに提供することを目的とした **個人運営の独立メディア** です。
      ランキングは下記の5軸による独自スコアで決定しており、アフィリエイト契約の有無・報酬単価は一切考慮していません。
    </p>

    <section class="mt-8 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-lg font-bold">✍️ 編集長プロフィール</h2>

      <div class="mt-4 flex items-start gap-4">
        <div class="flex-shrink-0 h-16 w-16 rounded-full bg-gradient-to-br from-violet-500 to-fuchsia-500 flex items-center justify-center text-3xl font-bold text-white" aria-hidden="true">
          Ao
        </div>
        <div class="flex-1">
          <p class="text-base font-bold text-white">Ao <span class="text-xs font-normal text-[#8a90a8]">（あお）</span></p>
          <p class="mt-1 text-xs text-violet-300">AIpedia 編集長 ／ 個人運営</p>
          <p class="mt-2 text-sm leading-relaxed text-[#c7cbde]">
            ビジネスパーソン向けに AIツールの比較・解説記事を執筆。日々の業務で ChatGPT・Claude・Gemini を併用しており、その実用感をもとに、過度な煽りなく中立的な情報提供を心がけています。
          </p>
          <p class="mt-2 text-xs text-[#8a90a8]">
            主な使用ツール：ChatGPT Plus / Claude Pro / Gemini（無料枠）
          </p>
          <p class="mt-3">
            <a href="/author/ao" class="text-xs text-violet-300 hover:text-violet-200 underline">→ 詳しいプロフィールを見る</a>
          </p>
        </div>
      </div>

      <div class="mt-5 rounded-xl border border-white/10 bg-white/[0.03] p-4">
        <div class="text-xs font-semibold uppercase tracking-widest text-violet-300">お問い合わせ</div>
        <p class="mt-2 text-sm text-white font-semibold"><a href="/contact" class="underline">お問い合わせフォーム</a></p>
        <p class="mt-1 text-xs text-[#8a90a8] leading-relaxed">記事の誤り指摘・取材・業務依頼は通常2営業日以内にご返信します。</p>
      </div>

      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <div class="text-xs font-semibold uppercase tracking-widest text-violet-300">編集責任</div>
          <p class="mt-2 text-sm text-[#c7cbde]">記事内容は公式ドキュメント・一次情報を基に編集長が確認のうえ公開。明確な誤りが判明した場合は速やかに修正します。</p>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <div class="text-xs font-semibold uppercase tracking-widest text-amber-300">情報源</div>
          <p class="mt-2 text-sm text-[#c7cbde]">各 AI ベンダーの公式ブログ・リリースノート、主要メディア（The Verge / TechCrunch / 日経 xTECH 等）を継続モニタリング。</p>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <div class="text-xs font-semibold uppercase tracking-widest text-emerald-300">独立性</div>
          <p class="mt-2 text-sm text-[#c7cbde]">アフィリエイト案件の有無は**ランキング順位・評価スコアに一切影響しません**。影響のある場合は開示します。</p>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <div class="text-xs font-semibold uppercase tracking-widest text-sky-300">透明性</div>
          <p class="mt-2 text-sm text-[#c7cbde]">PR表記・アフィリエイト開示・評価基準を全て公開。<a href="/disclosure" class="underline">アフィリエイト開示</a>も別ページで明示。</p>
        </div>
      </div>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-lg font-bold">運営情報</h2>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-[9rem_1fr]">
        <dt class="text-[#8a90a8]">サイト名</dt>
        <dd class="text-white">AIpedia（AIツール比較ランキング）</dd>
        <dt class="text-[#8a90a8]">運営開始</dt>
        <dd class="text-[#c7cbde]">2026年4月20日</dd>
        <dt class="text-[#8a90a8]">運営形態</dt>
        <dd class="text-[#c7cbde]">個人運営（編集長：<a href="/author/ao" class="underline">Ao</a>）</dd>
        <dt class="text-[#8a90a8]">連絡手段</dt>
        <dd class="text-[#c7cbde]"><a href="/contact" class="underline">お問い合わせフォーム</a>（通常2営業日以内に返信）</dd>
        <dt class="text-[#8a90a8]">所在地</dt>
        <dd class="text-[#c7cbde]">日本（詳細はお問い合わせフォームより）</dd>
        <dt class="text-[#8a90a8]">関連ポリシー</dt>
        <dd class="text-[#c7cbde]"><a href="/privacy" class="underline">プライバシーポリシー</a> ／ <a href="/disclosure" class="underline">アフィリエイト開示</a></dd>
      </dl>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-lg font-bold">評価5軸と配点</h2>
      <div class="mt-4 space-y-3">
        {axes.map((a) => (
          <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
            <div class="flex items-baseline justify-between">
              <div class="font-semibold">{a.label}</div>
              <div class="text-xs text-[#8a90a8]">配点 <span class="text-white font-bold">{a.weight}%</span></div>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-white/5">
              <div class="h-full rounded-full bg-gradient-to-r from-violet-500 to-fuchsia-500" style={`width: ${a.weight * 3}%`}></div>
            </div>
            <p class="mt-2 text-sm text-[#c7cbde]">{a.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-lg font-bold">編集方針（E-E-A-T 対応）</h2>
      <ul class="mt-3 space-y-2 text-sm text-[#c7cbde]">
        <li><strong class="text-white">Experience（経験）</strong>：編集長が普段の業務で利用しているツールを中心に解説。利用していないツールは公式情報・主要メディアの一次情報をもとに整理し、その旨を記事内で明示します。</li>
        <li><strong class="text-white">Expertise（専門性）</strong>：各 AI ベンダーの公式ブログ・リリースノートを継続モニタリング、一次情報を基に判断。</li>
        <li><strong class="text-white">Authoritativeness（権威性）</strong>：評価軸・配点・手法を全て開示し、検証可能な形で提示。</li>
        <li><strong class="text-white">Trustworthiness（信頼性）</strong>：アフィリエイトの影響を遮断、誤情報の指摘があれば速やかに修正。</li>
      </ul>
      <div class="mt-4 rounded-lg border border-amber-400/20 bg-amber-400/5 p-3">
        <p class="text-xs leading-relaxed text-[#c7cbde]"><strong class="text-amber-200">AI 利用方針：</strong>本サイトでは、記事の構成・下書きに生成AI（ChatGPT・Claude 等）を活用する場合があります。その場合も<strong class="text-white">公開前に編集長が事実確認・編集を行い</strong>、明らかな事実誤認は修正・削除しています。読者から誤情報のご指摘をいただいた場合は速やかに訂正します。</p>
      </div>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-lg font-bold">情報の鮮度保証</h2>
      <p class="mt-3 text-sm text-[#c7cbde]">AIツールの料金・機能は頻繁に変わります。以下の運用で鮮度を保っています：</p>
      <ul class="mt-3 space-y-2 text-sm text-[#c7cbde] list-disc pl-5">
        <li>全記事に「公開日」「更新日」を明記</li>
        <li>主要ツールの料金・機能変更は月次チェック</li>
        <li>大きな変更があった場合は記事を更新し、更新日を書き換え</li>
        <li>読者からの誤情報指摘は<a href="/contact" class="underline">お問い合わせ</a>で歓迎</li>
      </ul>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-lg font-bold">アフィリエイトと広告について</h2>
      <p class="mt-3 text-sm text-[#c7cbde] leading-relaxed">
        本サイトはAmazonアソシエイト、a8.net、もしもアフィリエイト、各種SaaSパートナープログラム、Google AdSense、忍者AdMax に参加しています（参加予定含む）。
        紹介リンク経由で契約いただくと、当サイトに成果報酬が発生する場合があります。この報酬はランキング順位・掲載有無・評価スコアには影響しません。
      </p>
      <p class="mt-3 text-sm text-[#c7cbde]">詳細は<a href="/disclosure" class="underline">アフィリエイト開示</a>をご確認ください。</p>
    </section>

    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-5 sm:p-6">
      <h2 class="text-lg font-bold">お問い合わせ・情報提供</h2>
      <p class="mt-3 text-sm text-[#c7cbde]">
        掲載情報の誤り、修正依頼、取材・プレスリリースは<a href="/contact" class="underline">お問い合わせフォーム</a>からご連絡ください。通常2営業日以内にご返信いたします。
      </p>
    </section>
  </article>
</BaseLayout>
