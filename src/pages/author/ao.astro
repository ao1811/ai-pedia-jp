---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import HeroVisual from '@/components/HeroVisual.astro';
import { SITE } from '@/data/site';
import { getCollection } from 'astro:content';

// Ao が編集した記事一覧（全guideがAoの担当）
const allGuides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const featuredGuides = allGuides.filter((g) => g.data.featured).slice(0, 6);
const totalArticles = allGuides.length;

// schema.org/Person
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}/author/ao#person`,
  name: 'Ao',
  alternateName: ['AIpedia 編集長 Ao', 'Ao（あお）'],
  url: `${SITE.url}/author/ao`,
  image: `${SITE.url}/author/ao-avatar.png`,
  jobTitle: '編集長 / AIツール検証ライター',
  description:
    'AIpedia 編集長。日々の業務で ChatGPT Plus / Claude Pro / Gemini Advanced / Cursor / Notion AI / PLAUD などを実利用し、その実用感をもとにビジネスパーソン向けの比較・解説記事を執筆。AIツール検証歴は2023年から3年以上、累計100本以上の比較記事を編集。',
  knowsAbout: [
    'AIツール',
    '生成AI',
    'ChatGPT',
    'Claude',
    'Gemini',
    'Cursor',
    'Claude Code',
    'AIライティング',
    'AI画像生成',
    'AIコーディング',
    'AI議事録',
    'AI翻訳',
    'AIエージェント',
    'プロンプトエンジニアリング',
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'AI ツール検証ライター・編集者',
    occupationLocation: { '@type': 'Country', name: 'Japan' },
  },
  worksFor: { '@id': `${SITE.url}/#editorial` },
  sameAs: [`${SITE.url}/about`],
};

const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
  title="編集長 Ao｜AIpedia"
  description="AIpedia 編集長 Ao（あお）のプロフィール。AIツール・生成AI領域を専門に、ChatGPT・Claude・Gemini など主要AIの比較・解説記事を執筆。個人運営の独立メディアとして、中立性と分かりやすさを最優先。"
  extraJsonLd={personSchema}
>
  <article class="mx-auto max-w-3xl px-4 sm:px-6 pt-6 sm:pt-10 pb-16">
    <Breadcrumbs items={[
      { label: 'ホーム', href: '/' },
      { label: '運営方針', href: '/about' },
      { label: '編集長 Ao' },
    ]} />

    <HeroVisual variant="guide" gradient="from-violet-500 to-fuchsia-500" className="mt-4" />

    {/* プロフィールヘッダー */}
    <header class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-6 sm:p-8">
      <div class="flex flex-col items-center text-center sm:flex-row sm:text-left sm:items-start sm:gap-6">
        <div class="flex-shrink-0 h-24 w-24 rounded-full bg-gradient-to-br from-violet-500 to-fuchsia-500 flex items-center justify-center text-4xl font-extrabold text-white" aria-hidden="true">
          Ao
        </div>
        <div class="mt-4 sm:mt-0 flex-1">
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Ao <span class="text-base font-normal text-[#8a90a8]">（あお）</span></h1>
          <p class="mt-1 text-sm text-violet-300">AIpedia 編集長 ／ AIツール検証ライター</p>
          <p class="mt-3 text-sm leading-relaxed text-[#c7cbde]">
            AIツール・生成AI 領域を専門とする AIpedia の編集長。<strong class="text-white">AIツール検証歴3年以上</strong>、日々の業務で ChatGPT Plus / Claude Pro / Gemini Advanced / Cursor / Notion AI / PLAUD を併用し、その実用感をもとに過度な煽りなく中立的な情報提供を心がけています。
          </p>
          <div class="mt-4 flex flex-wrap gap-2 text-[11px]">
            <span class="inline-flex items-center gap-1 rounded-md border border-emerald-400/30 bg-emerald-400/10 px-2 py-1 text-emerald-200">📍 日本</span>
            <span class="inline-flex items-center gap-1 rounded-md border border-violet-400/30 bg-violet-400/10 px-2 py-1 text-violet-200">📅 2023年〜AI検証</span>
            <span class="inline-flex items-center gap-1 rounded-md border border-amber-400/30 bg-amber-400/10 px-2 py-1 text-amber-200">📚 累計100本超</span>
          </div>
        </div>
      </div>
    </header>

    {/* 実際に契約・利用中のツール（E-E-A-T 強化：Experience の証拠） */}
    <section class="mt-6 rounded-2xl border border-emerald-400/20 bg-emerald-400/5 p-6">
      <h2 class="text-lg font-bold mb-3">💼 編集長が実際に契約・日常利用しているツール</h2>
      <p class="mb-4 text-sm text-[#c7cbde]">
        本サイトの記事は、編集長 Ao が以下を<strong class="text-white">実際に契約 or 購入し、自分の業務で日常的に使用</strong>した上で執筆しています。実利用していないツールはこの一覧から除外しています。
      </p>
      <div class="grid gap-2 sm:grid-cols-2 text-sm text-[#c7cbde]">
        <div class="rounded-md bg-white/[0.02] p-3"><strong class="text-white">対話AI</strong>：ChatGPT Plus / Claude Pro / Gemini Advanced</div>
        <div class="rounded-md bg-white/[0.02] p-3"><strong class="text-white">開発</strong>：Cursor Pro / Claude Code / GitHub Copilot</div>
        <div class="rounded-md bg-white/[0.02] p-3"><strong class="text-white">議事録</strong>：Notta Pro / PLAUD NOTE（実機）</div>
        <div class="rounded-md bg-white/[0.02] p-3"><strong class="text-white">業務</strong>：Notion AI / Slack / Google Workspace</div>
        <div class="rounded-md bg-white/[0.02] p-3"><strong class="text-white">画像</strong>：Midjourney Basic / Aiarty / ConoHa AI Canvas</div>
        <div class="rounded-md bg-white/[0.02] p-3"><strong class="text-white">家庭</strong>：Nest Hub Max + Nest Mini × 2（Gemini for Home）</div>
      </div>
    </section>

    {/* 専門領域 */}
    <section class="mt-8 rounded-2xl border border-white/5 bg-[#10121a] p-6">
      <h2 class="text-lg font-bold mb-4">🎯 専門領域</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <div class="text-xs font-semibold uppercase tracking-widest text-violet-300">対話AI</div>
          <p class="mt-2 text-sm text-[#c7cbde]">ChatGPT / Claude / Gemini の比較、料金、業務活用、エージェントモード解説</p>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <div class="text-xs font-semibold uppercase tracking-widest text-emerald-300">AI コーディング</div>
          <p class="mt-2 text-sm text-[#c7cbde]">Cursor / Claude Code / Copilot / v0 / Devin など開発系 AI ツール</p>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <div class="text-xs font-semibold uppercase tracking-widest text-pink-300">AI 画像・動画</div>
          <p class="mt-2 text-sm text-[#c7cbde]">Midjourney / DALL-E / Stable Diffusion / Veo / Runway などの活用</p>
        </div>
        <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
          <div class="text-xs font-semibold uppercase tracking-widest text-amber-300">業務効率化</div>
          <p class="mt-2 text-sm text-[#c7cbde]">AI 議事録（PLAUD / Notta）、AI ライティング、AI 翻訳、AI エージェント</p>
        </div>
      </div>
    </section>

    {/* 編集スタイル */}
    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-6">
      <h2 class="text-lg font-bold mb-3">✍️ 編集スタイル</h2>
      <ul class="space-y-2 text-sm text-[#c7cbde]">
        <li><strong class="text-white">中立性</strong>：アフィリエイト案件の有無は記事順位・評価に一切影響させない</li>
        <li><strong class="text-white">数字主義</strong>：料金・性能・ROI は具体的な数値で示す（曖昧な「便利」「すごい」を避ける）</li>
        <li><strong class="text-white">出典明示</strong>：公式ドキュメント・主要メディアの URL を必ず記事内に掲載</li>
        <li><strong class="text-white">誠実な pushback</strong>：流行りのツールでも、欠点・限界・向かない人は明確に書く</li>
        <li><strong class="text-white">読者ファースト</strong>：契約前に知っておくべき失敗事例・落とし穴を並べることが、結局は読者の利益になる</li>
      </ul>
    </section>

    {/* 注目記事 */}
    {featuredGuides.length > 0 && (
      <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-6">
        <h2 class="text-lg font-bold mb-4">📚 編集長おすすめ記事（{featuredGuides.length}本）</h2>
        <ul class="space-y-3">
          {featuredGuides.map((g) => (
            <li>
              <a href={`/guides/${g.id}`} class="block rounded-lg border border-white/5 bg-white/[0.02] p-4 hover:bg-white/[0.04] transition">
                <div class="flex items-start gap-3">
                  <span class="text-2xl">{g.data.heroEmoji}</span>
                  <div class="flex-1">
                    <div class="text-sm font-semibold text-white line-clamp-2">{g.data.title}</div>
                    <div class="mt-1 text-[11px] text-[#8a90a8]">
                      {fmt(g.data.publishedAt)} · {g.data.readTimeMin}分で読める
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-[#8a90a8]">
          全{totalArticles}記事は<a href="/sitemap/" class="underline">サイトマップ</a>から確認できます。
        </p>
      </section>
    )}

    {/* AI 利用ポリシー */}
    <section class="mt-6 rounded-2xl border border-amber-400/20 bg-amber-400/5 p-6">
      <h2 class="text-lg font-bold mb-3">🤖 AI 利用方針（透明性のため）</h2>
      <p class="text-sm leading-relaxed text-[#c7cbde]">
        本サイトでは、記事の構成・下書きに生成AI（ChatGPT・Claude 等）を活用する場合があります。その場合も <strong class="text-white">公開前に編集長 Ao が事実確認・編集を行い</strong>、明らかな事実誤認は修正・削除しています。読者から誤情報のご指摘をいただいた場合は速やかに訂正します。
      </p>
      <p class="mt-3 text-xs text-[#8a90a8]">
        参考：<a href="/about/" class="underline">運営方針・評価基準</a>、<a href="/disclosure/" class="underline">アフィリエイト開示</a>、<a href="/privacy/" class="underline">プライバシーポリシー</a>
      </p>
    </section>

    {/* 連絡先 */}
    <section class="mt-6 rounded-2xl border border-white/5 bg-[#10121a] p-6 text-center">
      <h2 class="text-base font-bold">✉️ 連絡先</h2>
      <p class="mt-2 text-sm text-[#c7cbde]">
        記事の誤り指摘・取材・業務依頼など、<a href="/contact/" class="underline text-violet-300">お問い合わせフォーム</a>からどうぞ。通常2営業日以内に返信します。
      </p>
    </section>
  </article>
</BaseLayout>
