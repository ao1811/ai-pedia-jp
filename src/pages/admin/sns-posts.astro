---
/**
 * SNS 投稿文ジェネレーター。
 *
 * 全ガイド記事について、X（Twitter）・Instagram・TikTok 向けの投稿文と
 * 推奨画像 URL を自動生成。1クリックコピーで SNS アプリに貼り付けるだけで投稿可能。
 *
 * URL: /admin/sns-posts
 * 認証：なし（URL を知っている前提）
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@/data/site';

// SNSアカウントハンドル（Instagramは @ai_pedia.jp、X/TikTokは @ai_pedia_jp）
const SNS = SITE.social as { x: string; instagram: string; tiktok: string };

const guides = await getCollection('guides');

// 公開日の新しい順で並び替え
const sortedGuides = guides.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

// 人気スコア計算（PopularGuides と揃える）
const NOW = Date.now();
const D30 = 30 * 24 * 60 * 60 * 1000;
const D90 = 90 * 24 * 60 * 60 * 1000;
function popularityScore(g: typeof sortedGuides[number]): number {
  let s = 0;
  if (g.data.featured) s += 30;
  const updated = (g.data.updatedAt ?? g.data.publishedAt).getTime();
  const published = g.data.publishedAt.getTime();
  if (NOW - updated <= D30) s += 20;
  if (NOW - published <= D90) s += 10;
  if (g.data.category === 'comparison') s += 8;
  s += (g.data.relatedTools?.length ?? 0) * 2;
  return s;
}

// 各記事に並び順用の派生値を持たせる
const guidesWithMeta = sortedGuides.map((g) => ({
  guide: g,
  publishedTs: g.data.publishedAt.getTime(),
  popularity: popularityScore(g),
}));

// カテゴリラベルマップ
const CATEGORY_JA: Record<string, string> = {
  comparison: '比較',
  howto: 'How-to',
  guide: 'ガイド',
  review: 'レビュー',
  trend: 'トレンド',
};
const CATEGORY_ICON: Record<string, string> = {
  comparison: '📊',
  howto: '📚',
  guide: '📖',
  review: '⭐',
  trend: '📈',
};
const CATEGORY_ACCENT: Record<string, string> = {
  comparison: 'text-cyan-300 border-cyan-400/30 bg-cyan-400/10',
  howto: 'text-emerald-300 border-emerald-400/30 bg-emerald-400/10',
  guide: 'text-violet-300 border-violet-400/30 bg-violet-400/10',
  review: 'text-amber-300 border-amber-400/30 bg-amber-400/10',
  trend: 'text-rose-300 border-rose-400/30 bg-rose-400/10',
};

// カテゴリごとの記事数を集計
const categoryCounts: Record<string, number> = {};
for (const { guide: g } of guidesWithMeta) {
  categoryCounts[g.data.category] = (categoryCounts[g.data.category] ?? 0) + 1;
}

/** タグ→ハッシュタグ変換（英数字/日本語そのまま #prefix） */
function toHashtag(tag: string): string {
  return '#' + tag.replace(/\s+/g, '').replace(/[・\-\/]/g, '');
}

/** 文字数調整（X は日本語140文字目安） */
function clip(text: string, max: number): string {
  if (text.length <= max) return text;
  return text.slice(0, max - 1) + '…';
}

type Post = {
  platform: 'x' | 'instagram' | 'tiktok';
  text: string;
  charCount: number;
  imageUrl: string;
  imageHint: string;
};

/** 記事から3プラットフォーム分の投稿を生成 */
function generatePosts(guide: typeof sortedGuides[number]): Post[] {
  const url = `${SITE.url}/guides/${guide.id.replace(/\.md$/, '')}/`;
  const title = guide.data.title;
  const desc = guide.data.description;
  const tldr = guide.data.tldr ?? desc;
  const emoji = guide.data.heroEmoji || '✨';
  const tags = guide.data.tags || [];
  const readTime = guide.data.readTimeMin;

  // ハッシュタグ生成
  const baseTagsX = ['#AIツール', '#AI活用', '#AIpedia'];
  const baseTagsIG = [
    '#AI',
    '#AIツール',
    '#AI活用',
    '#ChatGPT',
    '#Claude',
    '#Gemini',
    '#生成AI',
    '#AI比較',
    '#AIpedia',
    '#副業',
    '#AI副業',
    '#AIブロガー',
    '#テック',
    '#AIライフ',
  ];
  const baseTagsTT = [
    '#AI',
    '#AIツール',
    '#ChatGPT',
    '#AI比較',
    '#生成AI',
    '#おすすめ',
    '#fyp',
    '#foryou',
    '#学び',
  ];
  const articleHashtags = tags.slice(0, 4).map(toHashtag);

  // X: 140字目安（日本語）
  const xText = [
    `【${title}】`,
    '',
    clip(tldr, 80),
    '',
    `📖 ${readTime}分で読めます`,
    `👉 ${url}`,
    '',
    [...baseTagsX, ...articleHashtags.slice(0, 2)].join(' '),
  ].join('\n');

  // Instagram: 長文 + ハッシュタグ大量
  const igText = [
    `${emoji} ${title} ${emoji}`,
    '━━━━━━━━━━━━━',
    '',
    tldr,
    '',
    '📝 この記事でわかること：',
    ...(guide.data.faq?.slice(0, 3).map((f) => `• ${f.q}`) ?? [
      `• ${desc}`,
    ]),
    '',
    `⏱ 読了時間: 約${readTime}分`,
    '',
    '🔗 記事全文はプロフィールのリンクから',
    `→ ${SNS.instagram}`,
    '',
    '━━━━━━━━━━━━━',
    '',
    '役に立ったら「💾保存」で後から読み返せます！',
    'フォローで最新AI情報をお届け✨',
    '',
    '.',
    '.',
    '.',
    '',
    [...baseTagsIG, ...articleHashtags].join(' '),
  ].join('\n');

  // TikTok: 短め + トレンドハッシュタグ
  const ttText = [
    `${emoji} ${title}`,
    '',
    clip(desc, 60),
    '',
    '▶ 詳細はプロフのリンク',
    `→ ${SNS.tiktok}`,
    '',
    [...baseTagsTT, ...articleHashtags].join(' '),
  ].join('\n');

  // 記事別の画像（タイトル入り・3サイズ）
  const slug = guide.id.replace(/\.md$/, '');
  const imgOg = `${SITE.url}/og/og/guides/${slug}.png`;
  const imgSquare = `${SITE.url}/og/square/guides/${slug}.png`;
  const imgStory = `${SITE.url}/og/story/guides/${slug}.png`;

  return [
    {
      platform: 'x',
      text: xText,
      charCount: xText.length,
      imageUrl: imgOg,
      imageHint:
        '💡 1200x630（OG標準）。X投稿に画像を添付すると目立ちやすい。URLを貼ると自動でOG画像が表示されるので、添付は任意。',
    },
    {
      platform: 'instagram',
      text: igText,
      charCount: igText.length,
      imageUrl: imgSquare,
      imageHint:
        '💡 1080x1080（正方形）。Instagram Feed用のサイズ。そのまま投稿できます。',
    },
    {
      platform: 'tiktok',
      text: ttText,
      charCount: ttText.length,
      imageUrl: imgStory,
      imageHint:
        '💡 1080x1920（縦長）。TikTokのカバー画像 / Instagram Story / Reels に最適。動画にテキストを重ねる土台としても。',
    },
  ];
}

const allPosts = sortedGuides.map((g) => ({
  guide: g,
  posts: generatePosts(g),
}));

const platformMeta = {
  x: {
    name: 'X (旧Twitter)',
    icon: '𝕏',
    color: 'from-neutral-400 to-zinc-600',
    limit: 280,
    openUrl: 'https://x.com/compose/post',
    tip: '画像1枚＋リンク形式が最もエンゲージ高い。朝7-9時 / 夜19-22時が狙い目。',
  },
  instagram: {
    name: 'Instagram',
    icon: '📷',
    color: 'from-pink-500 via-rose-500 to-orange-500',
    limit: 2200,
    openUrl: 'https://www.instagram.com/',
    tip: 'Feed投稿＋Reelsが王道。「プロフィールのリンク」と必ず明記。夜20-22時が強い。',
  },
  tiktok: {
    name: 'TikTok',
    icon: '🎵',
    color: 'from-cyan-400 via-fuchsia-500 to-rose-500',
    limit: 2200,
    openUrl: 'https://www.tiktok.com/upload',
    tip: '動画内で記事タイトルと3つのポイントを画像で見せるのが定番。昼12-13時 / 夜20-22時。',
  },
};
---

<BaseLayout
  title="SNS投稿文ジェネレーター"
  description="X・Instagram・TikTok用の投稿文を記事別に自動生成。コピー→貼り付けで即投稿。"
  noIndex
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 sm:pt-10 pb-20">
    <div class="flex items-center gap-2 text-xs">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-rose-400/40 bg-rose-400/10 px-3 py-1 text-rose-300">
        🔒 非公開
      </span>
      <a href="/admin/dashboard" class="text-[#8a90a8] hover:text-white">← ダッシュボードに戻る</a>
    </div>

    <h1 class="mt-3 text-balance text-3xl sm:text-4xl font-extrabold tracking-tight">
      📱 SNS投稿文ジェネレーター
    </h1>
    <p class="mt-2 text-sm text-[#c7cbde]">
      全{sortedGuides.length}記事について、X（旧Twitter）・Instagram・TikTok 向けの投稿文と推奨画像を自動生成。
      <br />
      <span class="text-amber-300">
        1クリックでコピー → 各アプリで貼り付け → 投稿、で完了します。
      </span>
    </p>

    {/* 運用ガイド */}
    <section class="mt-8 rounded-2xl border border-violet-400/20 bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 p-6">
      <h2 class="text-lg font-bold tracking-tight">🚀 使い方（3ステップ・1記事あたり3分）</h2>
      <ol class="mt-3 grid gap-3 sm:grid-cols-3 text-sm">
        <li class="rounded-xl bg-white/5 p-4">
          <div class="text-xs font-bold text-violet-300">STEP 1</div>
          <div class="mt-1 font-medium">投稿する記事を選ぶ</div>
          <div class="mt-1 text-[12px] text-[#8a90a8]">新着記事ほど効果が高い。週3-5本ペースを推奨。</div>
        </li>
        <li class="rounded-xl bg-white/5 p-4">
          <div class="text-xs font-bold text-violet-300">STEP 2</div>
          <div class="mt-1 font-medium">「コピー」ボタンを押す</div>
          <div class="mt-1 text-[12px] text-[#8a90a8]">投稿文＋ハッシュタグがクリップボードに入ります。</div>
        </li>
        <li class="rounded-xl bg-white/5 p-4">
          <div class="text-xs font-bold text-violet-300">STEP 3</div>
          <div class="mt-1 font-medium">各SNSアプリで貼り付け → 投稿</div>
          <div class="mt-1 text-[12px] text-[#8a90a8]">画像はOG画像（下部リンク）をそのまま使えます。</div>
        </li>
      </ol>
    </section>

    {/* プラットフォーム別の投稿時間帯ヒント */}
    <section class="mt-6 grid gap-3 sm:grid-cols-3">
      {Object.entries(platformMeta).map(([key, meta]) => (
        <div class="rounded-xl border border-white/10 bg-[#10121a] p-4">
          <div class="flex items-center gap-2">
            <span class="text-xl">{meta.icon}</span>
            <span class="font-bold">{meta.name}</span>
          </div>
          <div class="mt-2 text-[12px] text-[#c7cbde]">{meta.tip}</div>
          <a
            href={meta.openUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-flex items-center gap-1 text-[11px] text-violet-300 hover:text-violet-200"
          >
            {meta.name} を開く →
          </a>
        </div>
      ))}
    </section>

    {/* 🔎 タブ（新着・人気・カテゴリ別） + 検索 */}
    <section class="mt-10">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">
        📝 記事別の投稿文（全 {sortedGuides.length} 件）
      </h2>

      {/* 検索ボックス */}
      <div class="mb-4">
        <div class="relative max-w-md">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[#8a90a8]">🔍</span>
          <input
            type="text"
            id="sns-search"
            placeholder="タイトル・タグで絞り込み..."
            class="w-full rounded-lg border border-white/10 bg-white/5 pl-9 pr-3 py-2 text-sm text-white placeholder:text-[#8a90a8] focus:border-violet-400/50 focus:outline-none focus:ring-1 focus:ring-violet-400/30"
          />
        </div>
      </div>

      {/* タブ切替 */}
      <div class="mb-6 flex flex-wrap gap-2 border-b border-white/10 pb-3" role="tablist">
        <button
          type="button"
          data-sns-tab="latest"
          class="sns-tab inline-flex items-center gap-1.5 rounded-lg border border-violet-400/40 bg-violet-400/15 px-3.5 py-2 text-sm font-bold text-violet-100 transition"
          role="tab"
          aria-selected="true"
        >
          🆕 新着 <span class="ml-0.5 rounded-md bg-white/10 px-1.5 py-0.5 text-[10px] font-bold tabular-nums">{guidesWithMeta.length}</span>
        </button>
        <button
          type="button"
          data-sns-tab="popular"
          class="sns-tab inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.04] px-3.5 py-2 text-sm font-bold text-[#c7cbde] hover:bg-white/[0.08] transition"
          role="tab"
          aria-selected="false"
        >
          🔥 人気 <span class="ml-0.5 rounded-md bg-white/10 px-1.5 py-0.5 text-[10px] font-bold tabular-nums">{guidesWithMeta.length}</span>
        </button>
        {(['comparison', 'howto', 'guide', 'review', 'trend'] as const).map((cat) =>
          (categoryCounts[cat] ?? 0) > 0 && (
            <button
              type="button"
              data-sns-tab={cat}
              class="sns-tab inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/[0.04] px-3.5 py-2 text-sm font-bold text-[#c7cbde] hover:bg-white/[0.08] transition"
              role="tab"
              aria-selected="false"
            >
              {CATEGORY_ICON[cat]} {CATEGORY_JA[cat]} <span class="ml-0.5 rounded-md bg-white/10 px-1.5 py-0.5 text-[10px] font-bold tabular-nums">{categoryCounts[cat]}</span>
            </button>
          )
        )}
      </div>

      {/* 検索ヒット 0件のフォールバック */}
      <div
        id="sns-empty"
        class="hidden rounded-2xl border border-white/10 bg-[#10121a] p-10 text-center text-[#8a90a8]"
      >
        🔍 該当する記事が見つかりませんでした。検索キーワードや別のタブを試してみてください。
      </div>

      <div class="space-y-6" id="sns-articles-container">
        {allPosts.map(({ guide, posts }, idx) => {
          const meta = guidesWithMeta[idx];
          const tagsLower = (guide.data.tags ?? []).map((t) => t.toLowerCase()).join(' ');
          const searchTokens = [
            guide.data.title.toLowerCase(),
            (guide.data.description ?? '').toLowerCase(),
            tagsLower,
            guide.data.category,
          ].join(' ');
          return (
          <article
            class="sns-article rounded-2xl border border-white/10 bg-[#10121a] overflow-hidden"
            data-category={guide.data.category}
            data-popular-score={meta.popularity}
            data-published-ts={meta.publishedTs}
            data-search-text={searchTokens}
          >
            {/* 記事ヘッダー */}
            <header class="border-b border-white/5 p-4 sm:p-5">
              <div class="flex items-start gap-3">
                <span class="text-2xl">{guide.data.heroEmoji}</span>
                <div class="min-w-0 flex-1">
                  <div class="mb-1.5 flex flex-wrap items-center gap-1.5">
                    <span class={`inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-bold ${CATEGORY_ACCENT[guide.data.category] ?? 'text-violet-300 border-violet-400/30 bg-violet-400/10'}`}>
                      {CATEGORY_ICON[guide.data.category] ?? '📄'} {CATEGORY_JA[guide.data.category] ?? guide.data.category}
                    </span>
                    {guide.data.featured && (
                      <span class="inline-flex items-center gap-1 rounded-full border border-amber-400/40 bg-amber-400/10 px-2 py-0.5 text-[10px] font-bold text-amber-200">
                        ⭐ 編集部おすすめ
                      </span>
                    )}
                    {NOW - guide.data.publishedAt.getTime() <= D30 && (
                      <span class="inline-flex items-center gap-1 rounded-full border border-rose-400/40 bg-rose-400/10 px-2 py-0.5 text-[10px] font-bold text-rose-200">
                        🆕 新着30日
                      </span>
                    )}
                    <span class="inline-flex items-center gap-1 rounded-full border border-white/10 bg-white/[0.04] px-2 py-0.5 text-[10px] text-[#8a90a8]">
                      🔥 スコア {meta.popularity}
                    </span>
                  </div>
                  <h3 class="text-base font-bold tracking-tight text-white line-clamp-2">
                    {guide.data.title}
                  </h3>
                  <div class="mt-1 flex flex-wrap items-center gap-2 text-[11px] text-[#8a90a8]">
                    <span>{guide.data.publishedAt.toLocaleDateString('ja-JP')}</span>
                    <span>•</span>
                    <span>{guide.data.readTimeMin}分</span>
                    <span>•</span>
                    <a
                      href={`/guides/${guide.id.replace(/\.md$/, '')}/`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-violet-300 hover:text-violet-200"
                    >
                      記事を開く →
                    </a>
                  </div>
                </div>
              </div>
            </header>

            {/* 3プラットフォームの投稿文 */}
            <div class="grid gap-0 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-white/5">
              {posts.map((post) => {
                const meta = platformMeta[post.platform];
                const overLimit = post.charCount > meta.limit;
                return (
                  <div class="p-4 sm:p-5">
                    {/* プラットフォームヘッダー */}
                    <div class="flex items-center justify-between mb-3">
                      <div class="flex items-center gap-2">
                        <span class={`inline-flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br ${meta.color} text-sm font-bold`}>
                          {meta.icon}
                        </span>
                        <span class="text-sm font-bold">{meta.name}</span>
                      </div>
                      <div class={`text-[11px] ${overLimit ? 'text-rose-400' : 'text-[#8a90a8]'}`}>
                        {post.charCount} / {meta.limit}
                      </div>
                    </div>

                    {/* 投稿文プレビュー */}
                    <pre
                      data-post-text
                      class="whitespace-pre-wrap break-words rounded-lg border border-white/10 bg-black/30 p-3 text-[11px] text-[#c7cbde] font-sans leading-relaxed max-h-64 overflow-y-auto"
                    >{post.text}</pre>

                    {/* アクションボタン */}
                    <div class="mt-3 flex flex-wrap gap-2">
                      <button
                        type="button"
                        data-copy-btn
                        class="inline-flex items-center gap-1.5 rounded-lg bg-gradient-to-r from-violet-500 to-fuchsia-500 px-3 py-1.5 text-xs font-bold text-white hover:opacity-90 transition"
                      >
                        📋 コピー
                      </button>
                      <a
                        href={meta.openUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs text-[#c7cbde] hover:bg-white/10 transition"
                      >
                        {meta.icon} {meta.name} を開く
                      </a>
                    </div>

                    {/* 画像推奨 */}
                    <div class="mt-3 rounded-lg border border-white/5 bg-white/[0.02] p-3">
                      <div class="text-[10px] font-bold uppercase tracking-wider text-[#8a90a8] mb-1">
                        🖼️ 推奨画像
                      </div>
                      <div class="text-[11px] text-[#c7cbde]">{post.imageHint}</div>
                      <a
                        href={post.imageUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-2 inline-flex items-center gap-1 text-[11px] text-violet-300 hover:text-violet-200"
                      >
                        OG画像をダウンロード →
                      </a>
                    </div>
                  </div>
                );
              })}
            </div>
          </article>
          );
        })}
      </div>
    </section>

    {/* 画像編集ツールの案内 */}
    <section class="mt-10 rounded-2xl border border-white/10 bg-[#10121a] p-6">
      <h2 class="text-lg font-bold tracking-tight">🎨 画像編集にはこれを使うと楽です</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <a
          href="https://www.canva.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-white/10 bg-white/5 p-4 hover:bg-white/10 transition"
        >
          <div class="font-bold">Canva（無料）</div>
          <div class="mt-1 text-[12px] text-[#8a90a8]">
            1080x1080 (IG) / 1080x1920 (TikTok) テンプレ豊富。OG画像を貼り付けてトリミング・装飾。
          </div>
        </a>
        <a
          href="https://www.figma.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-white/10 bg-white/5 p-4 hover:bg-white/10 transition"
        >
          <div class="font-bold">Figma（無料）</div>
          <div class="mt-1 text-[12px] text-[#8a90a8]">
            デザイナー向け。一度テンプレを作ると高速で差分生成できる。
          </div>
        </a>
        <a
