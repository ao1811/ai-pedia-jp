<script is:inline>
  /**
   * コピー機能：ボタンから隣接する <pre data-post-text> のテキストをクリップボードへ。
   */
  document.addEventListener('click', (e) => {
    const btn = e.target?.closest('[data-copy-btn]');
    if (!btn) return;
    const container = btn.closest('.p-4, .sm\\:p-5, div');
    const pre = container?.querySelector('[data-post-text]');
    if (!pre) return;
    const text = pre.textContent || '';
    navigator.clipboard
      .writeText(text)
      .then(() => {
        const original = btn.innerHTML;
        btn.innerHTML = '✅ コピー済み！';
        btn.classList.add('opacity-70');
        setTimeout(() => {
          btn.innerHTML = original;
          btn.classList.remove('opacity-70');
        }, 1500);
      })
      .catch(() => {
        alert('コピーに失敗しました。手動で選択してください。');
      });
  });

  /**
   * タブ切替（新着 / 人気 / カテゴリ別）+ 検索フィルタ + ソート。
   * - 新着: data-published-ts 降順
   * - 人気: data-popular-score 降順、同点は data-published-ts 降順
   * - カテゴリ: data-category が一致する記事のみ表示、新着順
   * 検索: data-search-text に対する部分一致（AND 検索）
   */
  (function () {
    const container = document.getElementById('sns-articles-container');
    const empty = document.getElementById('sns-empty');
    const searchInput = document.getElementById('sns-search');
    const tabs = document.querySelectorAll('.sns-tab');
    if (!container || !tabs.length) return;

    let activeTab = 'latest';
    let searchQuery = '';

    function applyFilter() {
      const articles = Array.from(container.querySelectorAll('.sns-article'));
      const tokens = searchQuery
        .toLowerCase()
        .split(/\s+/)
        .filter(Boolean);

      // フィルタ対象を決定
      let visible = articles.filter((el) => {
        // タブ条件
        if (activeTab === 'latest' || activeTab === 'popular') {
          // 全件対象
        } else {
          if (el.dataset.category !== activeTab) return false;
        }
        // 検索条件
        if (tokens.length > 0) {
          const text = el.dataset.searchText || '';
          if (!tokens.every((t) => text.includes(t))) return false;
        }
        return true;
      });

      // ソート
      visible.sort((a, b) => {
        if (activeTab === 'popular') {
          const sa = parseInt(a.dataset.popularScore || '0', 10);
          const sb = parseInt(b.dataset.popularScore || '0', 10);
          if (sa !== sb) return sb - sa;
        }
        // 新着順（タブ問わず最終フォールバック）
        const ta = parseInt(a.dataset.publishedTs || '0', 10);
        const tb = parseInt(b.dataset.publishedTs || '0', 10);
        return tb - ta;
      });

      // DOM 並べ替え
      const visibleSet = new Set(visible);
      // 表示ON/OFF
      for (const a of articles) {
        a.classList.toggle('hidden', !visibleSet.has(a));
      }
      // 順序適用
      for (const a of visible) {
        container.appendChild(a);
      }

      // 空メッセージ
      if (empty) {
        empty.classList.toggle('hidden', visible.length > 0);
      }
    }

    function setActiveTab(tabName) {
      activeTab = tabName;
      for (const tab of tabs) {
        const isActive = tab.dataset.snsTab === tabName;
        tab.setAttribute('aria-selected', String(isActive));
        if (isActive) {
          tab.classList.remove('border-white/10', 'bg-white/[0.04]', 'text-[#c7cbde]');
          tab.classList.add('border-violet-400/40', 'bg-violet-400/15', 'text-violet-100');
        } else {
          tab.classList.remove('border-violet-400/40', 'bg-violet-400/15', 'text-violet-100');
          tab.classList.add('border-white/10', 'bg-white/[0.04]', 'text-[#c7cbde]');
        }
      }
      applyFilter();
    }

    // タブクリック
    for (const tab of tabs) {
      tab.addEventListener('click', () => setActiveTab(tab.dataset.snsTab));
    }

    // 検索（即時反映、デバウンス）
    if (searchInput) {
      let debounce;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(debounce);
        debounce = setTimeout(() => {
          searchQuery = (e.target.value || '').trim();
          applyFilter();
        }, 120);
      });
    }

    // 初期表示
    applyFilter();
  })();
</script>
