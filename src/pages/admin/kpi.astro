---
/**
 * 統合KPIダッシュボード（シンプル版）。
 * ・Looker Studio 埋込（GA4/Search Consoleデータ自動表示）
 * ・各ASPへのワンクリックアクセス（収益はそれぞれの管理画面で確認）
 * ・手動入力KPI（任意、データがあれば表示）
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  sites,
  LOOKER_STUDIO_EMBED_URL,
  LOOKER_STUDIO_REPORT_URL,
  manualKpi,
  goals,
  sumRevenue,
} from '@/data/kpi';

// 手動入力データの有無
const hasManualData = manualKpi.some((k) => (k.pv ?? 0) > 0 || sumRevenue(k) > 0);
const latestMonth = manualKpi.length > 0
  ? [...new Set(manualKpi.map((k) => k.yearMonth))].sort().at(-1)
  : null;

// 月次収益レビュー用のASP一覧（ワンクリックで収益確認）
const revenueSources = [
  {
    name: 'Google AdSense',
    icon: '💰',
    url: 'https://www.google.com/adsense/new/u/0/reports/home',
    color: 'from-emerald-400 to-teal-500',
    note: '先月の収益を「レポート」で確認',
  },
  {
    name: '忍者AdMax',
    icon: '🥷',
    url: 'https://admax.shinobi.jp/app/reports',
    color: 'from-neutral-400 to-gray-600',
    note: '月次レポートで収益合計',
  },
  {
    name: 'a8.net',
    icon: '🎯',
    url: 'https://pub.a8.net/a8v2/media/reportAction.do',
    color: 'from-red-400 to-rose-600',
    note: '成果発生・確定報酬',
  },
  {
    name: 'Amazon アソシエイト',
    icon: '📦',
    url: 'https://affiliate.amazon.co.jp/home/reports',
    color: 'from-orange-400 to-yellow-500',
    note: '紹介料合計',
  },
];
---

<BaseLayout
  title="統合KPIダッシュボード"
  description="運営者用KPIダッシュボード。非公開ページ。"
  noIndex
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 sm:pt-10">
    <div class="flex items-center gap-2 text-xs">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-rose-400/40 bg-rose-400/10 px-3 py-1 text-rose-300">🔒 非公開</span>
      <span class="text-[#8a90a8]">運営者向け</span>
      <a href="/admin/dashboard" class="ml-auto text-[#c7cbde] hover:text-white">← ダッシュボード</a>
    </div>
    <h1 class="mt-3 text-balance text-3xl sm:text-4xl font-extrabold tracking-tight">
      📊 統合KPIダッシュボード
    </h1>
    <p class="mt-2 text-sm text-[#c7cbde]">
      GA4のPV・ユーザー数は下のLooker Studioで自動表示。ASP収益は月1回「月次レビュー」で各管理画面にワンクリックアクセス。
    </p>

    {/* Looker Studio 統合ビュー（最上部に大きく配置） */}
    <section class="mt-8">
      <div class="mb-3 flex items-baseline justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">📈 アクセス数（自動更新）</h2>
        <div class="flex items-center gap-3 text-xs">
          {LOOKER_STUDIO_REPORT_URL && (
            <a href={LOOKER_STUDIO_REPORT_URL} target="_blank" rel="noopener noreferrer" class="text-amber-300 hover:text-amber-200">Looker Studio で開く →</a>
          )}
          <a href="/admin/looker-setup" class="text-[#8a90a8] hover:text-white">セットアップ</a>
        </div>
      </div>

      {LOOKER_STUDIO_EMBED_URL ? (
        <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#10121a]">
          <iframe
            src={LOOKER_STUDIO_EMBED_URL}
            width="100%"
            height="900"
            frameborder="0"
            allowfullscreen
            sandbox="allow-scripts allow-same-origin allow-popups"
            loading="lazy"
            title="Looker Studio dashboard"
          ></iframe>
        </div>
      ) : LOOKER_STUDIO_REPORT_URL ? (
        <div class="rounded-2xl border border-violet-400/20 bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 p-8 text-center">
          <div class="text-4xl">📊</div>
          <a href={LOOKER_STUDIO_REPORT_URL} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-violet-500 to-fuchsia-500 px-5 py-3 text-sm font-bold text-white hover:opacity-90 transition">
            Looker Studio レポートを開く →
          </a>
        </div>
      ) : (
        <div class="rounded-2xl border border-dashed border-white/10 bg-[#10121a] p-8 text-center">
          <a href="/admin/looker-setup" class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-violet-500 to-fuchsia-500 px-5 py-3 text-sm font-bold text-white">
            Looker Studio をセットアップ
          </a>
        </div>
      )}
    </section>

    {/* 月次レビュー：ワンクリックで各ASP */}
    <section class="mt-10 rounded-2xl border border-amber-400/20 bg-gradient-to-br from-amber-500/5 to-orange-500/5 p-5 sm:p-6">
      <div class="flex items-start justify-between flex-wrap gap-3">
        <div>
          <h2 class="text-lg font-bold">🔁 月次収益レビュー（毎月1回、5分）</h2>
          <p class="mt-1 text-sm text-[#c7cbde]">各ASPの管理画面を開いて先月の収益を確認。記録は不要、見るだけでOK。</p>
        </div>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {revenueSources.map((s) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative overflow-hidden rounded-xl border border-white/10 bg-[#10121a] p-4 hover:border-amber-400/40 transition"
          >
            <div class={`absolute -right-6 -top-6 h-16 w-16 rounded-full bg-gradient-to-br ${s.color} opacity-20 blur-2xl group-hover:opacity-40 transition-opacity`}></div>
            <div class="relative">
              <div class="flex items-center justify-between">
                <span class="text-2xl">{s.icon}</span>
                <span class="text-xs text-amber-300">開く →</span>
              </div>
              <div class="mt-2 text-sm font-bold text-white">{s.name}</div>
              <div class="mt-1 text-[11px] text-[#8a90a8]">{s.note}</div>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-5 rounded-xl border border-white/5 bg-white/[0.02] p-4 text-xs text-[#c7cbde]">
        <strong class="text-amber-300">💡 毎月の運用ルーティン（3分）</strong>
        <ol class="mt-2 space-y-1 list-decimal pl-5">
          <li>月初に上の4つを順にクリック（新しいタブで開く）</li>
          <li>先月の収益をさらっと確認（記録不要）</li>
          <li>目立った変化があれば<a href="/admin/dashboard" class="underline">ダッシュボード</a>に手動メモ or 記事の改善計画へ</li>
        </ol>
        <p class="mt-2 text-[#8a90a8]">※ PV・ユーザー数は上のLooker Studioで自動表示されるので、ここで確認不要です。</p>
      </div>
    </section>

    {/* サイト別クイックリンク */}
    <section class="mt-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">🌐 サイト別 GA4 / Search Console</h2>
      <div class="grid gap-3 lg:grid-cols-2">
        {sites.map((s) => (
          <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
            <div class="flex items-baseline justify-between flex-wrap gap-2">
              <div>
                <h3 class="text-base font-bold text-white">{s.name}</h3>
                <p class="mt-0.5 text-[11px] text-[#8a90a8]">{s.tech}</p>
              </div>
              <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-xs text-amber-300 hover:text-amber-200">サイト →</a>
            </div>
            <div class="mt-3 grid gap-1.5 text-[11px]">
              {s.ga4Id && (
                <a href={`https://analytics.google.com/analytics/web/?authuser=0#/p${s.ga4Id}/reports/defaulthome`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-md border border-white/5 bg-white/[0.03] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10">
                  <span>📊</span><span>GA4</span>
                </a>
              )}
              {s.searchConsoleProperty && (
                <a href={`https://search.google.com/search-console?resource_id=${encodeURIComponent(s.searchConsoleProperty)}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 rounded-md border border-white/5 bg-white/[0.03] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10">
                  <span>🔍</span><span>Search Console</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 目標（軽く表示） */}
    <section class="mt-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">🎯 目標マイルストーン</h2>
      <div class="grid gap-3 lg:grid-cols-3">
        {Object.entries(goals).map(([, g]) => (
          <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
            <div class="text-sm font-bold text-white">{g.label}</div>
            <div class="mt-3 space-y-2 text-[12px]">
              <div class="flex items-center justify-between rounded-lg border border-violet-400/20 bg-violet-400/5 px-3 py-2">
                <span class="text-violet-300 font-bold">AIpedia</span>
                <span class="text-[#c7cbde]">PV {(g.aipedia.pv/1000).toFixed(1)}K / ¥{(g.aipedia.revenue/1000).toFixed(0)}k</span>
              </div>
              <div class="flex items-center justify-between rounded-lg border border-emerald-400/20 bg-emerald-400/5 px-3 py-2">
                <span class="text-emerald-300 font-bold">oshi-tame</span>
                <span class="text-[#c7cbde]">PV {(g.oshitame.pv/1000).toFixed(1)}K / ¥{(g.oshitame.revenue/1000).toFixed(0)}k</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 手動入力（実データあれば表示、なければ折りたたみ） */}
    {hasManualData && (
      <section class="mt-10">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">
          📝 月次スナップショット（手動）
          {latestMonth && <span class="ml-2 text-[#c7cbde]">{latestMonth}</span>}
        </h2>
        <div class="grid gap-3 lg:grid-cols-2">
          {sites.map((site) => {
            const latest = latestMonth
              ? manualKpi.find((k) => k.site === site.slug && k.yearMonth === latestMonth)
              : undefined;
            if (!latest || ((latest.pv ?? 0) === 0 && sumRevenue(latest) === 0)) return null;
            return (
              <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
                <h3 class="text-base font-bold text-white">{site.name}</h3>
                <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
                  <div class="rounded-lg border border-white/5 bg-white/[0.02] p-3">
                    <div class="text-[10px] uppercase text-[#8a90a8]">PV</div>
                    <div class="mt-1 text-lg font-extrabold text-white">{latest.pv?.toLocaleString() ?? '—'}</div>
                  </div>
                  <div class="rounded-lg border border-white/5 bg-white/[0.02] p-3">
                    <div class="text-[10px] uppercase text-[#8a90a8]">ユーザー</div>
                    <div class="mt-1 text-lg font-extrabold text-white">{latest.users?.toLocaleString() ?? '—'}</div>
                  </div>
                  <div class="rounded-lg border border-emerald-400/20 bg-emerald-400/5 p-3">
                    <div class="text-[10px] uppercase text-emerald-300">合計収益</div>
                    <div class="mt-1 text-lg font-extrabold text-emerald-200">¥{sumRevenue(latest).toLocaleString()}</div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
        <div class="mt-3 text-xs text-[#8a90a8]">
          編集：<code class="rounded bg-white/5 px-1">src/data/kpi.ts</code> の <code class="rounded bg-white/5 px-1">manualKpi</code>
        </div>
      </section>
    )}
  </section>
</BaseLayout>
