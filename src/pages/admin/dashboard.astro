---
/**
 * 運営者向けダッシュボード（noindex・公開はしない運用想定）。
 * 各サービス（GA4 / AdSense / 忍者AdMax / a8.net / Amazon / Search Console）への
 * クイックアクセスと、サイトの現状・目標・チェックリストを1画面に集約。
 *
 * URL: /admin/dashboard
 * 認証：なし（URLを知っている前提の運用）。本格認証は Cloudflare Access 併用推奨。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { tools } from '@/data/tools';
import { amazonProducts } from '@/data/amazon';
import { affiliateUrls } from '@/data/affiliate';

const guides = await getCollection('guides');
const sponsoredCount = Object.keys(affiliateUrls).filter((k) => affiliateUrls[k]).length;
const amazonCount = Object.keys(amazonProducts).length;

const services = [
  {
    name: 'Google Analytics 4',
    desc: 'PV・ユーザー数・流入経路',
    url: 'https://analytics.google.com/analytics/web/',
    color: 'from-amber-400 to-orange-500',
    icon: '📊',
    actions: [
      { label: 'リアルタイム', url: 'https://analytics.google.com/analytics/web/#/realtime' },
      { label: 'レポート', url: 'https://analytics.google.com/analytics/web/#/reports' },
    ],
  },
  {
    name: 'Google Search Console',
    desc: '検索パフォーマンス・インデックス状況',
    url: 'https://search.google.com/search-console?resource_id=sc-domain%3Aai-pedia.jp',
    color: 'from-blue-400 to-indigo-500',
    icon: '🔍',
    actions: [
      { label: 'パフォーマンス', url: 'https://search.google.com/search-console/performance/search-analytics?resource_id=sc-domain%3Aai-pedia.jp' },
      { label: 'サイトマップ', url: 'https://search.google.com/search-console/sitemaps?resource_id=sc-domain%3Aai-pedia.jp' },
    ],
  },
  {
    name: 'Google AdSense',
    desc: 'ディスプレイ広告の収益・審査状況',
    url: 'https://www.google.com/adsense/new/u/0/home',
    color: 'from-emerald-400 to-teal-500',
    icon: '💰',
    actions: [
      { label: 'レポート', url: 'https://www.google.com/adsense/new/u/0/reports/home' },
      { label: 'サイト', url: 'https://www.google.com/adsense/new/u/0/sites' },
      { label: '広告', url: 'https://www.google.com/adsense/new/u/0/ads/overview' },
    ],
  },
  {
    name: '忍者AdMax',
    desc: 'クリック報酬型広告の収益',
    url: 'https://admax.shinobi.jp/',
    color: 'from-neutral-400 to-gray-600',
    icon: '🥷',
    actions: [
      { label: 'レポート', url: 'https://admax.shinobi.jp/app/reports' },
      { label: '広告枠一覧', url: 'https://admax.shinobi.jp/app/tags' },
    ],
  },
  {
    name: 'a8.net',
    desc: '成果報酬型アフィリエイト',
    url: 'https://pub.a8.net/',
    color: 'from-red-400 to-rose-600',
    icon: '🎯',
    actions: [
      { label: '参加中プログラム', url: 'https://pub.a8.net/a8v2/media/partnerProgramListAction.do' },
      { label: 'レポート', url: 'https://pub.a8.net/a8v2/media/reportAction.do' },
      { label: 'プログラム検索', url: 'https://pub.a8.net/a8v2/media/searchAction.do' },
    ],
  },
  {
    name: 'Amazon アソシエイト',
    desc: '商品紹介型アフィリエイト',
    url: 'https://affiliate.amazon.co.jp/',
    color: 'from-orange-400 to-yellow-500',
    icon: '📦',
    actions: [
      { label: 'レポート', url: 'https://affiliate.amazon.co.jp/home/reports' },
      { label: 'リンク作成', url: 'https://affiliate.amazon.co.jp/home/productlinks/all' },
    ],
  },
  {
    name: 'Cloudflare Pages',
    desc: 'デプロイ・サイト統計・環境変数',
    url: 'https://dash.cloudflare.com/',
    color: 'from-orange-500 to-amber-600',
    icon: '☁️',
    actions: [
      { label: 'Pages プロジェクト', url: 'https://dash.cloudflare.com/?to=/:account/pages' },
      { label: 'Web Analytics', url: 'https://dash.cloudflare.com/?to=/:account/web-analytics' },
    ],
  },
  {
    name: 'GitHub リポジトリ',
    desc: 'ソースコード・コミット履歴',
    url: 'https://github.com/ao1811/ai-pedia-jp',
    color: 'from-slate-500 to-zinc-700',
    icon: '🐙',
    actions: [
      { label: 'コミット履歴', url: 'https://github.com/ao1811/ai-pedia-jp/commits/main' },
      { label: 'デプロイ状況', url: 'https://github.com/ao1811/ai-pedia-jp/actions' },
    ],
  },
];

const adSenseMilestones = [
  { label: 'AdSense 申請', status: '完了', note: '2026-04-21' },
  { label: 'AdSense 審査通過', status: '待機中', note: '1〜4週間見込み' },
  { label: '初回 ¥8,000 到達', status: '未達', note: 'PIN受領→本人確認必要' },
  { label: '初回支払い', status: '未達', note: '¥8,000到達月の翌月末' },
];

const amazonMilestones = [
  { label: 'アソシエイト登録', status: '完了', note: '仮登録状態' },
  { label: '3件売上発生（本審査要件）', status: '未達', note: '180日以内必須' },
  { label: '本審査通過', status: '未達', note: '3件発生後自動審査' },
  { label: 'ネイティブショッピング広告導入', status: '未達', note: '本審査後' },
];

const a8Status = [
  { label: '即時提携', count: 2, note: 'Value AI Writer / ConoHa AI Canvas' },
  { label: '審査中', count: 18, note: 'Notta、Plaud、DMM 生成AI CAMP 等' },
];

const ninjaStatus = [
  { label: '広告枠設置', count: 4, note: 'home-rankings-mid / home-bottom / in-article-top / in-article-bottom' },
];

const siteMetrics = [
  { label: '総ページ数', value: '158', hint: 'ツール14 / ガイド26 / タグ60+' },
  { label: 'ガイド記事数', value: String(guides.length) },
  { label: 'AIツール掲載数', value: String(tools.length) },
  { label: 'Amazon 商品登録数', value: String(amazonCount) },
  { label: 'アフィリエイト連携 (a8/Amazon等)', value: `${sponsoredCount}＋Amazon` },
];

const dailyTasks = [
  'GA4 リアルタイムでエラー確認',
  '忍者AdMax / a8.net / Amazon のメール受信確認',
  'Cloudflare Pages のデプロイ状態確認',
];
const weeklyTasks = [
  'a8.net 審査通過案件を確認 → URL を src/data/affiliate.ts に反映',
  'Search Console の新規インデックス状況をチェック',
  '人気記事TOP10に基づき追加記事のネタ出し',
  '週1〜3本の新記事追加',
];
const monthlyTasks = [
  'GA4 のページ別ユーザー数をレビュー、上位記事を強化',
  'AdSense 収益確認と広告配置の最適化',
  '料金・機能の変動を主要ツールで確認（月初に）',
  '使っていないASP プログラムの整理',
];
---

<BaseLayout
  title="運営ダッシュボード"
  description="管理者用ダッシュボード。非公開ページです。"
  noIndex
>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 sm:pt-10">
    <div class="flex items-center gap-2 text-xs">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-rose-400/40 bg-rose-400/10 px-3 py-1 text-rose-300">
        🔒 非公開
      </span>
      <span class="text-[#8a90a8]">運営者向け</span>
    </div>
    <h1 class="mt-3 text-balance text-3xl sm:text-4xl font-extrabold tracking-tight">
      運営ダッシュボード
    </h1>
    <p class="mt-2 text-sm text-[#c7cbde]">
      各サービスへのクイックアクセス、サイト現状、収益マイルストーン、運用チェックリストを1画面に集約。
    </p>

    {/* サイトメトリクス */}
    <section class="mt-8">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">📐 サイトメトリクス</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {siteMetrics.map((m) => (
          <div class="rounded-xl border border-white/10 bg-[#10121a] p-4">
            <div class="text-[11px] uppercase tracking-wider text-[#8a90a8]">{m.label}</div>
            <div class="mt-1 text-2xl font-extrabold text-white">{m.value}</div>
            {m.hint && <div class="mt-1 text-[10px] text-[#8a90a8]">{m.hint}</div>}
          </div>
        ))}
      </div>
    </section>

    {/* 外部サービス クイックリンク */}
    <section class="mt-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">🚀 クイックアクセス</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#10121a] p-5">
            <div class={`absolute -right-8 -top-8 h-24 w-24 rounded-full bg-gradient-to-br ${s.color} opacity-20 blur-2xl`}></div>
            <div class="relative">
              <div class="flex items-center justify-between">
                <span class="text-2xl">{s.icon}</span>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-[11px] text-[#c7cbde] hover:bg-white/10">
                  開く →
                </a>
              </div>
              <h3 class="mt-3 text-base font-bold tracking-tight text-white">{s.name}</h3>
              <p class="mt-1 text-[12px] text-[#8a90a8]">{s.desc}</p>
              {s.actions.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {s.actions.map((a) => (
                    <a
                      href={a.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center rounded-md border border-white/5 bg-white/[0.04] px-2 py-0.5 text-[11px] text-[#c7cbde] hover:bg-white/10 transition"
                    >
                      {a.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* 収益マイルストーン */}
    <section class="mt-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">🎯 収益マイルストーン</h2>
      <div class="grid gap-4 lg:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
          <h3 class="text-base font-bold">💰 Google AdSense</h3>
          <ol class="mt-3 space-y-2 text-sm">
            {adSenseMilestones.map((m) => (
              <li class="flex items-start gap-2">
                <span class={`mt-0.5 inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${m.status === '完了' ? 'bg-emerald-400/20 text-emerald-200' : m.status === '待機中' ? 'bg-amber-400/20 text-amber-200' : 'bg-white/10 text-[#8a90a8]'}`}>{m.status}</span>
                <div class="min-w-0 flex-1">
                  <div class="font-medium text-white">{m.label}</div>
                  {m.note && <div class="text-[11px] text-[#8a90a8]">{m.note}</div>}
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
          <h3 class="text-base font-bold">📦 Amazon アソシエイト</h3>
          <ol class="mt-3 space-y-2 text-sm">
            {amazonMilestones.map((m) => (
              <li class="flex items-start gap-2">
                <span class={`mt-0.5 inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${m.status === '完了' ? 'bg-emerald-400/20 text-emerald-200' : m.status === '待機中' ? 'bg-amber-400/20 text-amber-200' : 'bg-white/10 text-[#8a90a8]'}`}>{m.status}</span>
                <div class="min-w-0 flex-1">
                  <div class="font-medium text-white">{m.label}</div>
                  {m.note && <div class="text-[11px] text-[#8a90a8]">{m.note}</div>}
                </div>
              </li>
            ))}
          </ol>
        </div>
        <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
          <h3 class="text-base font-bold">🎯 a8.net 提携状況</h3>
          <div class="mt-3 grid gap-2">
            {a8Status.map((s) => (
              <div class="flex items-center justify-between rounded-lg border border-white/5 bg-white/[0.02] p-3">
                <div>
                  <div class="text-sm font-medium text-white">{s.label}</div>
                  <div class="text-[11px] text-[#8a90a8]">{s.note}</div>
                </div>
                <div class="text-xl font-extrabold text-white">{s.count}</div>
              </div>
            ))}
          </div>
        </div>
        <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
          <h3 class="text-base font-bold">🥷 忍者AdMax 設置状況</h3>
          <div class="mt-3 grid gap-2">
            {ninjaStatus.map((s) => (
              <div class="rounded-lg border border-white/5 bg-white/[0.02] p-3">
                <div class="flex items-center justify-between">
                  <div class="text-sm font-medium text-white">{s.label}</div>
                  <div class="text-xl font-extrabold text-white">{s.count}</div>
                </div>
                <div class="mt-1 text-[11px] text-[#8a90a8]">{s.note}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* 運用チェックリスト */}
    <section class="mt-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">📋 運用チェックリスト</h2>
      <div class="grid gap-4 lg:grid-cols-3">
        <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
          <h3 class="text-base font-bold">📅 毎日</h3>
          <ul class="mt-3 space-y-1.5 text-sm text-[#c7cbde]">
            {dailyTasks.map((t) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400"></span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
          <h3 class="text-base font-bold">📆 毎週</h3>
          <ul class="mt-3 space-y-1.5 text-sm text-[#c7cbde]">
            {weeklyTasks.map((t) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400"></span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-white/10 bg-[#10121a] p-5">
          <h3 class="text-base font-bold">📊 毎月</h3>
          <ul class="mt-3 space-y-1.5 text-sm text-[#c7cbde]">
            {monthlyTasks.map((t) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-400"></span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {/* Looker Studio 案内 */}
    <section class="mt-10 rounded-2xl border border-violet-400/20 bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 p-6">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <h2 class="text-lg font-bold tracking-tight">📈 もっと詳しく見たい？</h2>
          <p class="mt-2 text-sm text-[#c7cbde]">
            Google Looker Studio を使えば、GA4・Search Console・広告収益を統合したカスタムダッシュボードを無料で作れます。
          </p>
          <ul class="mt-3 space-y-1 text-sm text-[#c7cbde]">
            <li>✓ GA4 データソース直接接続（無料）</li>
            <li>✓ Search Console と統合（SEO流入可視化）</li>
            <li>✓ AdSense 収益もグラフ化可能</li>
            <li>✓ 自動更新・共有URL発行</li>
          </ul>
        </div>
        <a
          href="https://lookerstudio.google.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-violet-500 to-fuchsia-500 px-5 py-3 text-sm font-bold text-white hover:opacity-90 transition whitespace-nowrap"
        >
          Looker Studio を開く
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>

    {/* 管理者ページ */}
    <section class="mt-10">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-widest text-[#8a90a8]">🔒 運営者専用ページ</h2>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <a href="/admin/kpi" class="group rounded-2xl border border-violet-400/30 bg-gradient-to-br from-violet-500/5 to-fuchsia-500/5 p-5 hover:border-violet-400/60 transition">
          <div class="flex items-start gap-3">
            <span class="text-3xl">📈</span>
            <div>
              <div class="text-base font-bold text-white group-hover:text-violet-300">統合KPI ダッシュボード</div>
              <p class="mt-1 text-[12px] text-[#8a90a8]">
                ai-pedia.jp + oshi-tame.com の PV・ユーザー・収益を横断表示。Looker Studio 埋込対応。
              </p>
            </div>
          </div>
        </a>
        <a href="/admin/looker-setup" class="group rounded-2xl border border-white/10 bg-[#10121a] p-5 hover:border-violet-400/40 transition">
          <div class="flex items-start gap-3">
            <span class="text-3xl">📊</span>
            <div>
              <div class="text-base font-bold text-white group-hover:text-violet-300">Looker Studio 設定ガイド</div>
              <p class="mt-1 text-[12px] text-[#8a90a8]">
                2サイト統合ダッシュボードのステップバイステップ作成手順。
              </p>
            </div>
          </div>
        </a>
        <a href="/admin/accounts" class="group rounded-2xl border border-white/10 bg-[#10121a] p-5 hover:border-violet-400/40 transition">
          <div class="flex items-start gap-3">
            <span class="text-3xl">🔑</span>
            <div>
              <div class="text-base font-bold text-white group-hover:text-violet-300">アカウント一覧</div>
              <p class="mt-1 text-[12px] text-[#8a90a8]">
                全サービスのメアド・ID・設定場所を集約。
              </p>
            </div>
          </div>
        </a>
      </div>
    </section>

    {/* サイト内リンク */}
    <section class="mt-10 rounded-2xl border border-white/10 bg-[#10121a] p-5">
      <h2 class="text-base font-bold">🔗 サイト内ショートカット</h2>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <a href="/" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">トップ</a>
        <a href="/guides" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">徹底特集</a>
        <a href="/tags/%E6%96%B0%E6%A9%9F%E8%83%BD" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">新機能タグ</a>
        <a href="/compare?tools=chatgpt,claude,gemini" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">横並び比較</a>
        <a href="/search" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">サイト検索</a>
        <a href="/rss.xml" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">RSS</a>
        <a href="/ads.txt" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">ads.txt</a>
        <a href="/llms.txt" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">llms.txt</a>
        <a href="/sitemap-index.xml" class="rounded-lg border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[#c7cbde] hover:bg-white/10 transition">Sitemap</a>
      </div>
    </section>

    {/* 認証アップグレード案内 */}
    <section class="mt-8 rounded-xl border border-white/5 bg-white/[0.02] p-4 text-xs text-[#8a90a8]">
      <strong class="text-amber-300">ℹ️ 認証を強化する場合：</strong>
      このページは現在 noindex で検索除外済ですが、URL を知る誰でもアクセス可能です。
