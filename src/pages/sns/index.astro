---
import '@/styles/global.css';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const templates = [
  {
    href: '/sns/intro',
    label: 'サイト紹介',
    size: '1080×1080（Instagram フィード）',
    desc: '「ai-pediaとは？」のサイト紹介カード。初回フォロワー獲得・自己紹介投稿向け。',
    emoji: '✦',
    gradient: 'linear-gradient(135deg, #7c5cff, #ff5cd3)',
  },
  {
    href: '/sns/ranking',
    label: '今週のTOP3',
    size: '1080×1080（Instagram フィード）',
    desc: 'サイト上位3ツールの総合ランキング。月次/週次で投稿すると定期ネタに。',
    emoji: '🏆',
    gradient: 'linear-gradient(135deg, #fbbf24, #f97316)',
  },
  {
    href: '/sns/story',
    label: 'ストーリー・リール',
    size: '1080×1920（Stories / Reels / TikTok）',
    desc: '縦長フル。サイト紹介 + TOP3 + 5軸評価を1枚に集約したランディング用。',
    emoji: '📱',
    gradient: 'linear-gradient(135deg, #a78bfa, #ec4899)',
  },
];

const CATEGORY_JA: Record<string, string> = {
  comparison: '比較',
  howto: 'How-to',
  guide: 'ガイド',
  review: 'レビュー',
  trend: 'トレンド',
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>SNS投稿テンプレート | ai-pedia</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <style>
      body {
        background: #08090d;
        color: #fff;
        font-family: 'Inter', system-ui, 'Hiragino Sans', 'Yu Gothic', sans-serif;
        margin: 0;
        padding: 48px 24px 80px;
        min-height: 100vh;
      }
      .wrap { max-width: 1100px; margin: 0 auto; }
      h1 {
        font-size: 44px;
        font-weight: 900;
        letter-spacing: -0.02em;
        margin: 0 0 12px;
      }
      h1 .g {
        background: linear-gradient(90deg, #a78bfa, #ff5cd3, #fbbf24);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      .lead {
        color: #c7cbde;
        font-size: 16px;
        line-height: 1.7;
        max-width: 720px;
        margin: 0 0 40px;
      }
      h2 {
        font-size: 22px;
        font-weight: 800;
        margin: 48px 0 16px;
        letter-spacing: -0.01em;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 16px;
      }
      .card {
        display: block;
        padding: 24px;
        border-radius: 18px;
        background: #10121a;
        border: 1px solid rgba(255,255,255,0.08);
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s, border-color 0.15s;
      }
      .card:hover {
        transform: translateY(-2px);
        border-color: rgba(255,255,255,0.2);
      }
      .card-emoji {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 32px;
        color: white;
        font-weight: 900;
        margin-bottom: 14px;
      }
      .card-label {
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -0.01em;
        margin-bottom: 4px;
      }
      .card-size {
        font-size: 12px;
        color: #fbbf24;
        font-weight: 600;
        letter-spacing: 0.04em;
        margin-bottom: 10px;
      }
      .card-desc {
        font-size: 13px;
        color: #8a90a8;
        line-height: 1.6;
      }
      .guide-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 12px;
      }
      .guide-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 14px;
        background: #10121a;
        border: 1px solid rgba(255,255,255,0.06);
        text-decoration: none;
        color: inherit;
        font-size: 13px;
        transition: border-color 0.15s;
      }
      .guide-card:hover { border-color: rgba(255,255,255,0.2); }
      .guide-card .g-emoji { font-size: 28px; }
      .guide-card .g-title {
        font-weight: 700;
        line-height: 1.4;
        color: #fff;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .guide-card .g-cat {
        font-size: 10px;
        color: #8a90a8;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-top: 2px;
      }
      .howto {
        margin-top: 48px;
        padding: 28px 32px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(124,92,255,0.08), rgba(255,92,211,0.08));
        border: 1px solid rgba(167,139,250,0.3);
      }
      .howto h3 {
        margin: 0 0 14px;
        font-size: 18px;
        font-weight: 800;
      }
      .howto ol {
        margin: 0;
        padding-left: 22px;
        color: #d8dcf0;
        line-height: 1.9;
        font-size: 14px;
      }
      .howto code {
        background: rgba(255,255,255,0.06);
        padding: 2px 8px;
        border-radius: 4px;
        color: #fbbf24;
        font-size: 13px;
      }
      .howto strong { color: #fff; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1>SNS投稿 <span class="g">テンプレート</span></h1>
      <p class="lead">
        Instagram / TikTok / X に投稿する画像のテンプレート集。各ページを開き、DevTools から <code>#canvas</code> 要素をスクリーンショットすれば等倍PNGで保存できます。記事やランキングを更新すれば自動でテンプレにも反映されます。
      </p>

      <h2>基本テンプレート</h2>
      <div class="grid">
        {templates.map((t) => (
          <a class="card" href={t.href}>
            <div class="card-emoji" style={`background: ${t.gradient}`}>{t.emoji}</div>
            <div class="card-label">{t.label}</div>
            <div class="card-size">{t.size}</div>
            <div class="card-desc">{t.desc}</div>
          </a>
        ))}
      </div>

      <h2>特集記事カード（1080×1080）</h2>
      <p class="lead" style="margin-bottom: 16px;">
        既存の特集記事 {guides.length} 本ぶん、1枚ずつ画像化できます。記事タイトル / 絵文字 / カテゴリ / 投稿日が自動で入ります。
      </p>
      <div class="guide-grid">
        {guides.map((g) => (
          <a class="guide-card" href={`/sns/guide/${g.id}`}>
            <span class="g-emoji">{g.data.heroEmoji}</span>
            <div>
              <div class="g-title">{g.data.title}</div>
              <div class="g-cat">{CATEGORY_JA[g.data.category] ?? g.data.category}</div>
            </div>
          </a>
        ))}
      </div>

      <div class="howto">
        <h3>📸 スクリーンショットの取り方</h3>
        <ol>
          <li>テンプレのリンクを開く</li>
          <li><strong>F12</strong> で DevTools → 要素タブ</li>
          <li><code>div#canvas</code> を右クリック → <strong>Capture node screenshot</strong></li>
          <li>1080×1080（またはストーリーなら 1080×1920）のPNGがダウンロードされる</li>
        </ol>
      </div>

      <div class="howto" style="border-color: rgba(251,191,36,0.3); background: linear-gradient(135deg, rgba(251,191,36,0.05), rgba(244,114,182,0.05));">
        <h3>🚫 公開サイトでの扱い</h3>
        <ol>
          <li>全テンプレページは <code>noindex</code> 設定済み。Google 検索には出ません。</li>
          <li>本番デプロイ先（ai-pedia.jp/sns）にも公開されますが、リンクは貼っていないので実質非公開です。</li>
          <li>気になる場合は後で <code>_routes</code> か Cloudflare 側で <code>/sns/*</code> を 404 返すよう設定できます。</li>
        </ol>
      </div>
    </div>
  </body>
</html>
