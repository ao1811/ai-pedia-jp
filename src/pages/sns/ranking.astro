---
import SnsLayout from '@/layouts/SnsLayout.astro';
import { getRankedTools } from '@/data/tools';

const top3 = getRankedTools().slice(0, 3);

const now = new Date();
const yearMonth = `${now.getFullYear()}年${now.getMonth() + 1}月`;

const medals = ['🥇', '🥈', '🥉'];
const rankColors = [
  'linear-gradient(135deg, #fbbf24, #f59e0b)',
  'linear-gradient(135deg, #d1d5db, #9ca3af)',
  'linear-gradient(135deg, #f97316, #c2410c)',
];
---

<SnsLayout title="TOP3ランキング 正方形" width={1080} height={1080}>
  <div class="bg">
    <div class="blob blob1"></div>
    <div class="blob blob2"></div>

    <div class="inner">
      <div class="head">
        <div class="brand">
          <div class="logo">✦</div>
          <div class="brand-name">ai-pedia</div>
        </div>
        <div class="date">{yearMonth} 最新</div>
      </div>

      <div class="title-wrap">
        <div class="badge">🏆 総合ランキング</div>
        <h1 class="title">
          今、本当に使える<br />
          <span class="gradient">AIツール TOP 3</span>
        </h1>
      </div>

      <div class="cards">
        {top3.map((t, i) => (
          <div class={`card card-${i + 1}`}>
            <div class="rank" style={`background: ${rankColors[i]}`}>
              <span class="rank-medal">{medals[i]}</span>
              <span class="rank-num">{i + 1}</span>
            </div>
            <div class="emoji">{t.logoEmoji}</div>
            <div class="name-block">
              <div class="name">{t.name}</div>
              <div class="vendor">{t.vendor}</div>
            </div>
            <div class="score-block">
              <div class="score-label">総合スコア</div>
              <div class="score">{t.popularityScore}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="footer">
        <div class="url">ai-pedia.jp</div>
        <div class="cta">詳しい比較はサイトで →</div>
      </div>
    </div>
  </div>
</SnsLayout>

<style>
  .bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, #1a1030 0%, #08090d 55%, #000 100%);
    overflow: hidden;
  }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.4;
  }
  .blob1 { width: 500px; height: 500px; background: #fbbf24; top: -140px; right: -120px; }
  .blob2 { width: 480px; height: 480px; background: #7c5cff; bottom: -120px; left: -120px; }

  .inner {
    position: relative;
    height: 100%;
    padding: 64px 72px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    color: #fff;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .logo {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: linear-gradient(135deg, #7c5cff, #ff5cd3);
    display: grid;
    place-items: center;
    color: white;
    font-size: 36px;
    font-weight: 900;
  }
  .brand-name {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .date {
    font-size: 20px;
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(251,191,36,0.12);
    border: 1px solid rgba(251,191,36,0.35);
    color: #fbbf24;
    font-weight: 600;
  }

  .title-wrap { display: flex; flex-direction: column; gap: 14px; }
  .badge {
    display: inline-block;
    width: fit-content;
    font-size: 22px;
    font-weight: 700;
    padding: 8px 20px;
    border-radius: 999px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
  }
  .title {
    font-size: 70px;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .gradient {
    background: linear-gradient(90deg, #fbbf24, #ff5cd3, #a78bfa);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card {
    display: grid;
    grid-template-columns: 96px 88px 1fr auto;
    align-items: center;
    gap: 24px;
    padding: 20px 28px;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(10px);
  }
  .card-1 {
    background: linear-gradient(180deg, rgba(251,191,36,0.14), rgba(251,191,36,0.04));
    border-color: rgba(251,191,36,0.4);
    box-shadow: 0 20px 60px rgba(251,191,36,0.15);
  }

  .rank {
    width: 96px;
    height: 96px;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #0b0c10;
  }
  .rank-medal { font-size: 36px; line-height: 1; }
  .rank-num { font-size: 22px; font-weight: 900; letter-spacing: 0.05em; margin-top: 2px; }

  .emoji {
    font-size: 64px;
    text-align: center;
    line-height: 1;
  }

  .name-block { display: flex; flex-direction: column; gap: 4px; }
  .name {
    font-size: 38px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .vendor {
    font-size: 18px;
    color: #8a90a8;
  }

  .score-block {
    text-align: right;
  }
  .score-label {
    font-size: 14px;
    color: #8a90a8;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .score {
    font-size: 56px;
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(90deg, #a78bfa, #ff5cd3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.03em;
  }

  .footer {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }
  .url {
    font-size: 28px;
    font-weight: 800;
    background: linear-gradient(90deg, #a78bfa, #ff5cd3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .cta {
    font-size: 20px;
    color: #8a90a8;
  }
</style>
