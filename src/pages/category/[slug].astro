---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RankingCard from '@/components/RankingCard.astro';
import SponsoredCTA from '@/components/SponsoredCTA.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getToolsByCategory } from '@/data/tools';
import { getAffiliateUrl } from '@/data/affiliate';
import { CATEGORY_LABELS, type Category } from '@/types/tool';

export function getStaticPaths() {
  return (Object.keys(CATEGORY_LABELS) as Category[]).map((key) => ({
    params: { slug: key },
  }));
}

const { slug } = Astro.params;
const cat = CATEGORY_LABELS[slug as Category];
if (!cat) return Astro.redirect('/404');

const list = getToolsByCategory(slug!);
// カテゴリ内にアフィリエイト案件がある場合は中間に挟む
const sponsoredInCat = list.find((t) => Boolean(getAffiliateUrl(t.slug) ?? t.affiliateUrl));
const description = `${cat.ja}の最新AIツールランキング。${list.length}件を独自評価軸で比較。あなたの用途に最適な1本が見つかります。`;

const topPart = list.slice(0, Math.min(3, list.length));
const bottomPart = list.slice(3);
---

<BaseLayout title={`${cat.ja} AIツールランキング`} description={description}>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 pt-6 sm:pt-10">
    <Breadcrumbs
      items={[
        { label: 'ホーム', href: '/' },
        { label: 'カテゴリ', href: '/category' },
        { label: cat.ja },
      ]}
    />

    <div class="mt-6">
      <div class="flex items-center gap-3">
        <span class={`inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br ${cat.accent} text-3xl shadow-lg shadow-black/30`}>
          {cat.emoji}
        </span>
        <div>
          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
            {cat.ja} ランキング
          </h1>
          <p class="mt-1 text-sm text-[#8a90a8]">全 {list.length} ツール ・ スコア上位順</p>
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-3 md:grid-cols-2">
      {topPart.map((tool, i) => (
        <RankingCard tool={tool} rank={i + 1} />
      ))}
    </div>

    {sponsoredInCat && (
      <div class="mt-6">
        <SponsoredCTA slug={sponsoredInCat.slug} note="このカテゴリのおすすめ" />
      </div>
    )}

    {bottomPart.length > 0 && (
      <div class="mt-6 grid gap-3 md:grid-cols-2">
        {bottomPart.map((tool, i) => (
          <RankingCard tool={tool} rank={i + 4} />
        ))}
      </div>
    )}

    {list.length === 0 && (
      <div class="mt-10 rounded-2xl border border-white/5 bg-[#10121a] p-10 text-center text-[#8a90a8]">
        このカテゴリのツールは現在登録準備中です。
      </div>
    )}
  </section>
</BaseLayout>
